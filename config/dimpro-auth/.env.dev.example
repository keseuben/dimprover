# DIMPRO AUTH DEV ONLY · PROD DENY
# Copy values into the authoritative DEV runtime secret store. Do not commit real secrets.
DIMPRO_AUTH_ENVIRONMENT=DEV

# Least-privilege runtime role.
DIMPRO_AUTH_DATABASE_URL=postgresql://dimpro_auth_app_dev:<APP_PASSWORD>@db.dimpro.hu:5432/dimpro_auth_dev
# Dedicated DDL/migration role; never expose to the runtime process.
DIMPRO_AUTH_MIGRATION_DATABASE_URL=postgresql://dimpro_auth_migrator_dev:<MIGRATION_PASSWORD>@db.dimpro.hu:5432/dimpro_auth_dev
DIMPRO_AUTH_DB_SSL_MODE=verify-full
DIMPRO_AUTH_DB_CA_FILE=/etc/dimpro/certs/postgresql-internal-ca.crt
DIMPRO_AUTH_DB_APPLICATION_NAME=dimpro-auth-dev

# Minimum 32 random characters each. Use independent values.
DIMPRO_AUTH_OTP_PEPPER=<GENERATE_RANDOM_SECRET_MIN_32>
DIMPRO_AUTH_SESSION_PEPPER=<GENERATE_RANDOM_SECRET_MIN_32>
DIMPRO_AUTH_SSO_STATE_SECRET=<GENERATE_RANDOM_SECRET_MIN_32>

# OTP policy from DIMPRO AUTH spec v1.0.
DIMPRO_AUTH_OTP_TTL_SECONDS=300
DIMPRO_AUTH_OTP_MAX_ATTEMPTS=5
DIMPRO_AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
DIMPRO_AUTH_OTP_EMAIL_WINDOW_MINUTES=15
DIMPRO_AUTH_OTP_EMAIL_WINDOW_MAX_REQUESTS=5
DIMPRO_AUTH_OTP_IP_WINDOW_MINUTES=15
DIMPRO_AUTH_OTP_IP_WINDOW_MAX_REQUESTS=20

# Internal SSO abuse protection.
DIMPRO_AUTH_SSO_WINDOW_MINUTES=10
DIMPRO_AUTH_SSO_AUTHORIZE_IP_MAX_REQUESTS=60
DIMPRO_AUTH_SSO_TOKEN_IP_MAX_REQUESTS=120

# Level 1 session defaults.
DIMPRO_AUTH_SESSION_ABSOLUTE_SECONDS=1209600
DIMPRO_AUTH_SESSION_INACTIVITY_SECONDS=86400
DIMPRO_AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300

# DEV SSO endpoints.
DIMPRO_AUTH_DEV_ORIGIN=https://auth.dev.dimpro.hu
DIMPRO_AUTH_DEV_DRIVE_REDIRECT_URI=https://drive.dev.dimpro.hu/api/dimpro-auth/callback

# Existing DIMPRO SMTP profile is reused by sendDimproMail(profileId=noreply).
# Configure the authoritative DEV mail secret store separately.
