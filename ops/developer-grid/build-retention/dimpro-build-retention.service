[Unit]
Description=DIMPRO Build Node Retention V1
After=network.target
ConditionPathExists=/srv/dimpro-build
ConditionPathExists=/srv/dimpro-build/config/retention-v1.json

[Service]
Type=oneshot
User=dimproadmin
Group=dimproadmin
UMask=0027
Nice=10
IOSchedulingClass=idle
ExecStart=/srv/dimpro-build/bin/dimpro-build-retention-v1 --node-id %H --config /srv/dimpro-build/config/retention-v1.json --report-file /srv/dimpro-build/state/retention/latest.json --apply --confirm-token APPLY:ede4f314940503623dfb2006c406d6e13059c021dab8c86e28a354cb1db77ef4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/dimpro-build

[Install]
WantedBy=multi-user.target
