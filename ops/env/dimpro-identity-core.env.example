# DIMPRO Identity Core V010 server-side environment contract
# Never commit real secret values.

# Existing Supabase server connection
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>

# Feature gate: keep false until both SQL migrations and acceptance tests pass.
DIMPRO_IDENTITY_CORE_ENABLED=false

# HMAC pepper used only to derive the 64-character Send code hash.
# Recommended: openssl rand -base64 48
DIMPRO_SEND_CODE_PEPPER=<minimum-32-character-random-secret>

# Separate HMAC pepper for IP pseudonymization in audit/rate-limit records.
# Recommended: openssl rand -base64 48
DIMPRO_ACCESS_HASH_PEPPER=<minimum-32-character-random-secret>

# Separate signing secret for short-lived DIMPRO Send sessions.
# Recommended: openssl rand -base64 48
DIMPRO_SEND_SESSION_SECRET=<minimum-32-character-random-secret>

# 60–3600 seconds. Recommended default: 900 seconds.
DIMPRO_SEND_SESSION_TTL_SECONDS=900
