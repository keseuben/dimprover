# DIMPRO AUTH DEV ingress template · DEV ONLY · PROD DENY
# Render with: node scripts/dimpro-auth/render-nginx-dev.mjs
# This template intentionally does not define drive.dev.dimpro.hu; Drive keeps its own candidate vhost.

server {
    listen 80;
    listen [::]:80;
    server_name auth.dev.dimpro.hu;
    return 308 https://auth.dev.dimpro.hu$request_uri;
}

server {
    listen 80;
    listen [::]:80;
    server_name login.dev.dimpro.hu;
    return 308 https://login.dev.dimpro.hu$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name login.dev.dimpro.hu;

    ssl_certificate __DIMPRO_AUTH_DEV_TLS_CERTIFICATE__;
    ssl_certificate_key __DIMPRO_AUTH_DEV_TLS_CERTIFICATE_KEY__;

    # Friendly entry host only; technical auth/session cookies remain host-only on auth.dev.dimpro.hu.
    location / {
        return 307 https://auth.dev.dimpro.hu/login$is_args$args;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name auth.dev.dimpro.hu;

    ssl_certificate __DIMPRO_AUTH_DEV_TLS_CERTIFICATE__;
    ssl_certificate_key __DIMPRO_AUTH_DEV_TLS_CERTIFICATE_KEY__;

    client_max_body_size 1m;

    location / {
        proxy_http_version 1.1;
        proxy_pass __DIMPRO_AUTH_DEV_UPSTREAM__;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
