[Unit]
Description=DIMPRO Commerce reservation expiry cleanup worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=-/etc/dimpro/commerce-reservation-expiry-worker.env
ExecStart=/bin/bash -lc 'cd "${DIMPRO_APP_ROOT:-/root/dimprover}" && exec /usr/bin/node -r ./scripts/load-next-env.cjs ./scripts/run-commerce-reservation-expiry-worker.mjs'
TimeoutStartSec=300
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
