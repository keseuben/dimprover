                          window.setTimeout(() => {
                            const input = miniSheetInputRefs.current[cellKey(formulaTarget.rowIndex, formulaTarget.colIndex)];
                            const value = input?.value || miniSheetFormulaBar || "";
                            input?.focus();
                            input?.setSelectionRange(value.length, value.length);
                          }, 0);
                        }
                      }}
