                          event.preventDefault();
                          undoMiniSheetChange();
                          return;
                        }

                        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "y") {
                          event.preventDefault();
                          redoMiniSheetChange();
                          return;
