                            rowIndex: clamp(rowIndex + (event.key === "ArrowDown" ? 1 : event.key === "ArrowUp" ? -1 : 0), 0, miniSheetRows.length - 1),
                            colIndex: clamp(colIndex + (event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0), 0, miniSheetColumns.length - 1),
