      })
      .join("")

    const selectedSignatureSet = selectedSignatureKeys ? new Set(selectedSignatureKeys) : null
    const pdfContractorSigners = signatureGroups.filter((signer) => !selectedSignatureSet || selectedSignatureSet.has(signer.key))
    const contractorSignatureBlocks = pdfContractorSigners
      .map(
