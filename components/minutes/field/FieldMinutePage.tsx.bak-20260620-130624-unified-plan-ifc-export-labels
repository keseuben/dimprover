    }

    function buildHexPinLegend() {
      return `<div class="hexpin-legend">
        <div class="legend-title">HexPin jelmagyarázat</div>
        <div class="legend-grid">
          <div class="legend-card"><span class="legend-pin discipline-architecture">É</span><b>Szakág színe</b><small>A HexPin világos háttérszíne jelzi a szakágat.</small></div>
          <div class="legend-card"><span class="legend-outline gray"></span><b>Észrevétel</b><small>Vékony szürke kontúr, tájékoztató jellegű tétel.</small></div>
          <div class="legend-card"><span class="legend-side"></span><b>Javítandó hiba</b><small>Narancs kontúr és rövid oldalsáv.</small></div>
          <div class="legend-card"><span class="legend-alert orange">!</span><b>Súlyos hiba</b><small>Narancssárga felkiáltó jel.</small></div>
