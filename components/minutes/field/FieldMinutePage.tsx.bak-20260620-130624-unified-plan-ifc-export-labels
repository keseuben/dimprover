                <td><span class="pill ${markerStatusClass(markerStatus)}">${escapeHtml(markerStatus)}</span></td>
                <td>${escapeHtml(marker.issueResponsible || marker.responsible || issue.responsible || "-")}<small>${escapeHtml(marker.issueContractorRepresentative || issue.contractorRepresentative || "-")}</small></td>
                <td>${escapeHtml(marker.issueDeadline || marker.dueDate || issue.deadline || "-")}</td>
                <td colspan="2">${escapeHtml(marker.issueDescription || issue.description || "-")}</td>
              </tr>`
            }),
            ...issuePhotoMarkers.map(({ link, marker, meta }) => {
              const markerSeverity = marker.issueSeverity || issue.severity
              const markerStatus = marker.status || marker.issueStatus || issue.status
              return `
              <tr class="hj-row fhj-row ${hjToneClass(markerSeverity, markerStatus)}">
                <td></td>
                <td colspan="2"><b>${escapeHtml(marker.issueSerial || issue.serial)} / ${escapeHtml(marker.serial || "FHJ")}</b><small>FHJ fotóhely · ${escapeHtml(marker.photoSerial || "-")} · Szakág: ${escapeHtml(meta.label)}</small></td>
                <td><span class="pill pill-severity ${markerSeverityClass(markerSeverity)}">${escapeHtml(markerSeverity)}</span></td>
                <td><span class="pill ${markerStatusClass(markerStatus)}">${escapeHtml(markerStatus)}</span></td>
                <td>${escapeHtml(marker.issueResponsible || marker.responsible || issue.responsible || "-")}<small>${escapeHtml(marker.issueContractorRepresentative || issue.contractorRepresentative || "-")}</small></td>
                <td>${escapeHtml(marker.issueDeadline || marker.dueDate || issue.deadline || "-")}</td>
                <td>${escapeHtml(marker.photoSerial || "-")}</td>
                <td>${escapeHtml(marker.photoNote || marker.note || "Fotó készítésének helye a tervlapon.")}</td>
              </tr>`
            }),
          ].join("")
          : `<tr class="hj-row hj-normal"><td></td><td colspan="8">Nincs rögzített HJ / FHJ jelölés.</td></tr>`
        return `
          <tr class="issue-main-row">
