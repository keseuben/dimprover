    }

    const issueRows = selectedIssues
      .map((issue) => {
        const issuePhotos = photos.filter((photo) => photo.issueId === issue.id)
        const issuePlanLinks = selectedPlanLinks.filter((link) => link.issueId === issue.id)
        const issueMarkers = issuePlanLinks.flatMap((link) =>
          (link.planMarkers ?? [])
            .filter((marker) => marker.markerKind !== "photo" && marker.issueId === issue.id)
            .map((marker) => ({ link, marker, meta: getPlanIssueDisciplineMeta(marker.discipline) })),
