export default function FieldMinutePage({ onBack }: { onBack: () => void }) {
  const [issues, setIssues] = useState<FieldIssue[]>(initialIssues)
  const [photos, setPhotos] = useState<FieldPhoto[]>(initialPhotos)
  const [planLinks, setPlanLinks] = useState<IssuePlanLink[]>(initialPlanLinks)
  const [activeIssueId, setActiveIssueId] = useState(initialIssues[0]?.id ?? "")
  const [activeTab, setActiveTab] = useState<MobileTab>("issues")
  const [recordDate, setRecordDate] = useState(() => getTodayDateValue())
  const [saveMessage, setSaveMessage] = useState("Automatikus mentés aktív")
  const [isExporting, setIsExporting] = useState(false)
  const [signers, setSigners] = useState<SignerData>({
    inspectorName: "",
    inspectorRole: "Műszaki ellenőr",
    inspectorSignature: "",
  })
  const [contractorSigners, setContractorSigners] = useState<ContractorSigner[]>([])
  const [pdfAttachments, setPdfAttachments] = useState<PdfAttachment[]>([])
  const [editingPhotoId, setEditingPhotoId] = useState<string | null>(null)
  const [showPhotoChooser, setShowPhotoChooser] = useState(false)
  const [showPlanSourceMenu, setShowPlanSourceMenu] = useState(false)
  const planViewerObjectUrlRefs = useRef<Record<string, string>>({})
  const [showEmailPrepare, setShowEmailPrepare] = useState(false)
  const [pendingDeleteIssueId, setPendingDeleteIssueId] = useState<string | null>(null)
  const [emailPdfType, setEmailPdfType] = useState<EmailPdfType>("full")
  const [emailRecipient, setEmailRecipient] = useState("Generálkivitelező Kft. / Kovács Gáspár")
  const [openRightPanels, setOpenRightPanels] = useState<Record<RightPanelId, boolean>>({ photos: true, export: true, attachments: false, signatures: false })
  const [rightWorkspaceMode, setRightWorkspaceMode] = useState<"signatures" | "finalize" | null>(null)
  const [openCenterCard, setOpenCenterCard] = useState<"issue" | "voice" | "photos" | "plans" | null>(null)
  const [showDesktopProgressPanel, setShowDesktopProgressPanel] = useState(true)
  const [issueListView, setIssueListView] = useState<"compact" | "detail" | "list">("list")
  const [selectedIssueIds, setSelectedIssueIds] = useState<string[]>([])
  const [expandedPhotoId, setExpandedPhotoId] = useState<string | null>(null)
  const [expandedSignerKey, setExpandedSignerKey] = useState<string>("inspector")
  const cameraInputRef = useRef<HTMLInputElement | null>(null)
  const galleryInputRef = useRef<HTMLInputElement | null>(null)
  const pdfInputRef = useRef<HTMLInputElement | null>(null)
  const planUploadInputRef = useRef<HTMLInputElement | null>(null)

  const activeIssue = useMemo(
    () => issues.find((issue) => issue.id === activeIssueId) ?? issues[0],
    [activeIssueId, issues],
  )

  const activeIssuePhotos = useMemo(
    () => photos.filter((photo) => photo.issueId === activeIssue?.id),
    [activeIssue?.id, photos],
  )
  const activeIssuePlanLinks = useMemo(
    () => planLinks.filter((link) => link.issueId === activeIssue?.id),
    [activeIssue?.id, planLinks],
  )

  const pendingDeleteIssue = useMemo(
    () => issues.find((issue) => issue.id === pendingDeleteIssueId) ?? null,
    [issues, pendingDeleteIssueId],
  )
  const pendingDeleteIssuePhotoCount = useMemo(
    () => pendingDeleteIssue ? photos.filter((photo) => photo.issueId === pendingDeleteIssue.id).length : 0,
    [pendingDeleteIssue, photos],
  )
  const activeStepIndex = Math.max(0, fieldSteps.findIndex((step) => step.id === activeTab))
  const canGoPreviousStep = activeStepIndex > 0
  const canGoNextStep = activeStepIndex < fieldSteps.length - 1
  const goToPreviousStep = () => {
    if (!canGoPreviousStep) return
    setActiveTab(fieldSteps[activeStepIndex - 1].id)
  }
  const goToNextStep = () => {
    if (!canGoNextStep) return
    setActiveTab(fieldSteps[activeStepIndex + 1].id)
  }
  const toggleRightPanel = (panel: RightPanelId) => {
    setOpenRightPanels((current) => ({ ...current, [panel]: !current[panel] }))
  }

  const editingPhoto = photos.find((photo) => photo.id === editingPhotoId)
  const urgentCount = issues.filter((issue) => ["Magas", "Sürgős"].includes(issue.severity)).length
  const openCount = issues.filter((issue) => issue.status !== "Lezárva").length
  const issueListIsCompact = issueListView === "compact"
  const issueListIsList = issueListView === "list"
  const issueListModeLabel = issueListView === "detail" ? "részletes" : issueListView === "compact" ? "kompakt" : "lista"
  const allIssuesSelected = issues.length > 0 && selectedIssueIds.length === issues.length
  const issueReadinessRows = useMemo(() => {
    return issues.map((issue) => {
      const issuePhotos = photos.filter((photo) => photo.issueId === issue.id)
      const issuePlanLinks = planLinks.filter((link) => link.issueId === issue.id)
      const hasRequiredData = Boolean(
        issue.title.trim()
          && issue.location.trim()
          && issue.responsible.trim()
          && issue.deadline.trim(),
      )
      const hasPhoto = issuePhotos.length > 0
      const hasEditedPhoto = issuePhotos.some((photo) => photo.edited || photo.note.trim().length > 0)
      const hasPlan = issuePlanLinks.length > 0
      const hasPlanMarker = issuePlanLinks.some((link) => (link.planMarkers ?? []).some((marker) => marker.markerKind !== "photo"))
      const isClosed = hasRequiredData && hasPhoto && hasEditedPhoto && hasPlan && hasPlanMarker
      const percent = Math.round(
        (hasRequiredData ? 25 : 0)
        + (hasPhoto ? 20 : 0)
        + (hasEditedPhoto ? 15 : 0)
        + (hasPlan ? 15 : 0)
        + (hasPlanMarker ? 15 : 0)
        + (isClosed ? 10 : 0),
      )
      const missing = [
        hasRequiredData ? null : "adatlap",
        hasPhoto ? null : "fotó",
        hasEditedPhoto ? null : "fotószerkesztés",
        hasPlan ? null : "terv",
        hasPlanMarker ? null : "HJ felvétel",
        isClosed ? null : "kész",
      ].filter(Boolean).join(" · ") || "kész"

      return {
        id: issue.id,
        serial: issue.serial,
        title: issue.title,
        location: issue.location,
        responsible: issue.responsible,
        contractorRepresentative: issue.contractorRepresentative,
        deadline: issue.deadline,
        severity: issue.severity,
        status: issue.status,
        photoCount: issuePhotos.length,
        planCount: issuePlanLinks.length,
        hasRequiredData,
        hasPhoto,
        hasEditedPhoto,
        hasPlan,
        hasPlanMarker,
        isClosed,
        percent,
        missing,
      }
    })
  }, [issues, photos, planLinks])

  const responsibleGroups = useMemo(() => {
    const groups = new Map<string, FieldIssue[]>()
    issues.forEach((issue) => {
      const company = issue.responsible || "Nincs érintett vállalkozó megadva"
      const person = issue.contractorRepresentative || "Nincs érintett személy megadva"
      const key = `${company} · ${person}`
      groups.set(key, [...(groups.get(key) ?? []), issue])
    })
    return Array.from(groups.entries()).map(([responsible, groupIssues]) => ({ responsible, issues: groupIssues }))
  }, [issues])

  const signatureGroups = useMemo(() => {
    return responsibleGroups.map((group) => {
      const firstIssue = group.issues[0]
      const company = firstIssue?.responsible || "Nincs érintett vállalkozó megadva"
      const representative = firstIssue?.contractorRepresentative || ""
      const existing = contractorSigners.find((signer) => signer.key === group.responsible)
      return {
        key: group.responsible,
        company,
        representative: existing?.representative ?? representative,
        role: existing?.role ?? "Érintett vállalkozó képviselője",
        signature: existing?.signature ?? "",
        issueCount: group.issues.length,
      }
    })
  }, [contractorSigners, responsibleGroups])

  const issueReadinessAverage = useMemo(() => {
    if (!issueReadinessRows.length) return 0
    return Math.round(issueReadinessRows.reduce((sum, row) => sum + row.percent, 0) / issueReadinessRows.length)
  }, [issueReadinessRows])

  const workflowStatus = useMemo(() => {
    const hasIssueList = issues.length > 0
    const activeIssueReady = Boolean(
      activeIssue?.title.trim()
        && activeIssue.location.trim()
        && activeIssue.responsible.trim()
        && activeIssue.deadline.trim(),
    )
    const hasActivePhoto = activeIssuePhotos.length > 0
    const hasAnyPhoto = photos.length > 0
    const hasAnySignature = Boolean(
      signers.inspectorSignature
        || contractorSigners.some((signer) => signer.signature),
    )
    const exportWasPrepared = saveMessage.includes("PDF export elkészült") || saveMessage.includes("letöltés indítva")
    const exportReady = hasAnySignature || exportWasPrepared
    const attachmentState: WorkflowStepState = pdfAttachments.length ? "done" : "optional"
    const planState: WorkflowStepState = activeIssuePlanLinks.length ? "done" : "optional"

    const steps: { id: FieldStepId; label: string; state: WorkflowStepState; helper: string }[] = [
      { id: "issues", label: "Hibák listája", state: hasIssueList ? "done" : "pending", helper: hasIssueList ? `${issues.length} hiba rögzítve` : "Még nincs rögzített hiba" },
      { id: "form", label: "Hiba adatlap", state: activeIssueReady ? "done" : hasIssueList ? "partial" : "pending", helper: activeIssueReady ? "Aktív hiba alapadatai kitöltve" : "Megnevezés, helyszín, vállalkozó és határidő szükséges" },
      { id: "photos", label: "Fotók / tervfotók", state: hasActivePhoto ? "done" : hasAnyPhoto ? "partial" : "pending", helper: hasActivePhoto ? `${activeIssuePhotos.length} fotó az aktív hibán` : hasAnyPhoto ? `${photos.length} fotó más hibákhoz` : "Nincs kapcsolódó fotó" },
      { id: "plans", label: "Tervjelölés", state: planState, helper: activeIssuePlanLinks.length ? `${activeIssuePlanLinks.length} tervkapcsolat az aktív hibán` : "Opcionális: terv nélkül is rögzíthető" },
      { id: "export", label: "Export", state: exportReady ? "done" : hasIssueList ? "partial" : "pending", helper: exportReady ? "PDF / aláírás előkészítve" : pdfAttachments.length ? `${pdfAttachments.length} PDF melléklet csatolva` : "PDF export és mellékletek" },
    ]

    const score = [
      hasIssueList ? 1 : 0,
      activeIssueReady ? 1 : hasIssueList ? 0.45 : 0,
      hasActivePhoto ? 1 : hasAnyPhoto ? 0.55 : 0,
      exportReady ? 1 : hasIssueList ? 0.35 : 0,
    ].reduce((sum, value) => sum + value, 0)
    const attachmentBonus = pdfAttachments.length ? 0.2 : 0
    const progressPercent = Math.min(100, Math.round(((score + attachmentBonus) / 4) * 100))

    return { steps, progressPercent }
  }, [activeIssue, activeIssuePhotos.length, activeIssuePlanLinks.length, contractorSigners, issues.length, pdfAttachments.length, photos.length, saveMessage, signers.inspectorSignature])

  const missingPlanCropCount = useMemo(
    () => planLinks.reduce((count, link) => count + (link.planMarkers ?? []).filter((marker) => !marker.cropImageDataUrl).length, 0),
    [planLinks],
  )

  const missingPlanCropItems = useMemo(
    () => planLinks.flatMap((link) => {
      const issue = issues.find((item) => item.id === link.issueId)
      return (link.planMarkers ?? [])
        .filter((marker) => !marker.cropImageDataUrl)
        .map((marker) => ({
          issueSerial: issue?.serial || marker.serial || link.markerLabel,
          markerSerial: marker.serial || link.markerLabel,
          planName: link.planName,
        }))
    }),
    [issues, planLinks],
  )

  const planMarkerCount = useMemo(
    () => planLinks.reduce((count, link) => count + ((link.planMarkers ?? []).filter((marker) => marker.markerKind !== "photo").length), 0),
    [planLinks],
  )

  const activeIssuePlanMarkerCount = useMemo(
    () => activeIssuePlanLinks.reduce((count, link) => count + ((link.planMarkers ?? []).filter((marker) => marker.markerKind !== "photo").length), 0),
    [activeIssuePlanLinks],
  )

  const activeContractorLabel = activeIssue
    ? `${activeIssue.responsible || "Érintett vállalkozó"}${activeIssue.contractorRepresentative ? ` / ${activeIssue.contractorRepresentative}` : ""}`
    : "Aktív vállalkozó"

  const emailSubject = useMemo(() => {
    const dateLabel = recordDate.replaceAll("-", ". ")
    return `Terepi hibafelvételi jegyzőkönyv – Duna Part Lakópark – ${dateLabel}.`
  }, [recordDate])

  const emailMessage = useMemo(() => {
    const pdfTypeLabel = emailPdfType === "full"
      ? "teljes hibajegyzéket"
      : emailPdfType === "active-contractor"
        ? "az Önöket érintő hibajegyzéket"
        : "a vállalkozónként bontott hibajegyzékeket"
    return `Tisztelt Címzett!

Mellékelten küldöm a helyszíni bejárás során rögzített ${pdfTypeLabel}.
Kérem a hibák határidőre történő javítását, valamint a javítást követő visszajelzést.

Üdvözlettel:
${signers.inspectorName || ""}`
  }, [emailPdfType, signers.inspectorName])

  function copyEmailText() {
    const emailText = `Címzett: ${emailRecipient || "-"}
Tárgy: ${emailSubject}

${emailMessage}`
    navigator.clipboard?.writeText(emailText)
      .then(() => setSaveMessage("Email szöveg vágólapra másolva"))
      .catch(() => {
        setSaveMessage("Email szöveg másolása nem sikerült")
        window.alert(emailText)
      })
  }

  async function downloadPreparedEmailPdf() {
    if (emailPdfType === "contractor-pack") {
      await exportResponsiblePdfs()
      return
    }
    if (emailPdfType === "active-contractor" && activeIssue) {
      const group = responsibleGroups.find((item) => item.issues.some((issue) => issue.id === activeIssue.id))
      if (group) {
        await exportIssuesPdf(group.issues, `Email előkészítés · ${group.responsible}`, createFieldPdfFilename("felelos", group.responsible), [group.responsible])
        return
      }
    }
    await exportFieldPdf()
  }

  function updateActiveIssue(patch: Partial<FieldIssue>) {
    if (!activeIssue) return
    setIssues((current) =>
      current.map((issue) => (issue.id === activeIssue.id ? { ...issue, ...patch } : issue)),
    )
    setSaveMessage("Változás rögzítve helyben")
  }

  function addDeadlineDays(days: number) {
    if (!activeIssue) return
    const baseDate = activeIssue.deadline || recordDate
    updateActiveIssue({ deadline: addDaysToDate(baseDate, days) })
  }

  function addIssue() {
    const nextNumber = issues.length + 1
    const nextIssue: FieldIssue = {
      id: `field-${String(nextNumber).padStart(3, "0")}`,
      serial: `TH-${String(nextNumber).padStart(3, "0")}`,
      title: "Új terepi hiba",
      location: "",
      description: "",
      severity: "Közepes",
      responsible: "",
      contractorRepresentative: "",
      deadline: recordDate,
      status: "Új",
      note: "",
    }

    setIssues((current) => [...current, nextIssue])
    setActiveIssueId(nextIssue.id)
    setActiveTab("form")
    setSaveMessage(`${nextIssue.serial} létrehozva`)
  }

  function requestIssueDelete(issueId: string) {
    setPendingDeleteIssueId(issueId)
  }

  function cancelIssueDelete() {
    setPendingDeleteIssueId(null)
  }

  function toggleIssueSelection(issueId: string) {
    setSelectedIssueIds((current) => current.includes(issueId) ? current.filter((id) => id !== issueId) : [...current, issueId])
  }

  function toggleAllIssueSelection() {
    setSelectedIssueIds((current) => current.length === issues.length ? [] : issues.map((issue) => issue.id))
  }

  function deleteSelectedIssues() {
    if (!selectedIssueIds.length) return
    const selectedSet = new Set(selectedIssueIds)
    const removedSerials = issues.filter((issue) => selectedSet.has(issue.id)).map((issue) => issue.serial).join(", ")
    const nextIssues = issues.filter((issue) => !selectedSet.has(issue.id))
    setIssues(nextIssues)
    setPhotos((current) => current.filter((photo) => !selectedSet.has(photo.issueId)))
    setPlanLinks((current) => current.filter((link) => !selectedSet.has(link.issueId)))
    setContractorSigners((current) => current.filter((signer) => nextIssues.some((issue) => signer.key.includes(issue.responsible))))
    setExpandedPhotoId((current) => {
      const expandedPhoto = photos.find((photo) => photo.id === current)
      return expandedPhoto && selectedSet.has(expandedPhoto.issueId) ? null : current
    })
    if (activeIssueId && selectedSet.has(activeIssueId)) {
      const nextActiveIssue = nextIssues[0]
      setActiveIssueId(nextActiveIssue?.id ?? "")
      setActiveTab(nextActiveIssue ? "issues" : "form")
    }
    setSelectedIssueIds([])
    setSaveMessage(`${removedSerials || selectedIssueIds.length + " tétel"} törölve`)
  }

  function confirmIssueDelete() {
    if (!pendingDeleteIssue) return
    const issueToDelete = pendingDeleteIssue
    const issueId = issueToDelete.id
    const nextIssues = issues.filter((issue) => issue.id !== issueId)
    setIssues(nextIssues)
    setPhotos((current) => current.filter((photo) => photo.issueId !== issueId))
    setPlanLinks((current) => current.filter((link) => link.issueId !== issueId))
    setContractorSigners((current) => current.filter((signer) => !signer.key.includes(issueToDelete.responsible)))
    setExpandedPhotoId((current) => {
      const expandedPhoto = photos.find((photo) => photo.id === current)
      return expandedPhoto?.issueId === issueId ? null : current
    })

    if (activeIssueId === issueId) {
      const nextActiveIssue = nextIssues[0]
      setActiveIssueId(nextActiveIssue?.id ?? "")
      setActiveTab(nextActiveIssue ? "issues" : "form")
    }
    setSelectedIssueIds((current) => current.filter((id) => id !== issueId))
    setPendingDeleteIssueId(null)
    setSaveMessage(`${issueToDelete.serial} törölve`)
  }

  async function handlePhotoUpload(files: FileList | null) {
    if (!files?.length || !activeIssue) return

    const selectedFiles = Array.from(files).filter((file) => {
      if (file.size > MAX_IMAGE_UPLOAD_SIZE) {
        window.alert(`${file.name} túl nagy. Maximum képméret: ${formatFileSize(MAX_IMAGE_UPLOAD_SIZE)}.`)
        return false
      }
      return true
    })
    if (!selectedFiles.length) return
    const imagePayloads = await Promise.all(selectedFiles.map((file) => imageFileToPdfDataUrl(file)))
    const nextPhotos = selectedFiles.map((file, index) => {
      const nextNumber = photos.length + index + 1
      return {
        id: `photo-${String(nextNumber).padStart(3, "0")}`,
        issueId: activeIssue.id,
        serial: `F-${String(nextNumber).padStart(3, "0")}`,
        name: file.name,
        note: "",
        url: URL.createObjectURL(file),
        dataUrl: imagePayloads[index]?.dataUrl || "",
        originalSize: file.size,
        compressedSize: imagePayloads[index]?.compressedSize || file.size,
        width: imagePayloads[index]?.width || 0,
        height: imagePayloads[index]?.height || 0,
        edited: false,
        appendixLayout: "half" as PhotoAppendixLayout,
        appendixOrientation: "portrait" as PhotoAppendixOrientation,
        category: "photo" as PhotoCategory,
      }
    })

    setPhotos((current) => [...current, ...nextPhotos])
    setExpandedPhotoId(nextPhotos[0]?.id ?? expandedPhotoId)
    setOpenRightPanels((current) => ({ ...current, photos: true }))
    setActiveTab("photos")
    setSaveMessage(`${nextPhotos.length} fotó hozzáadva az aktív hibához`)
  }

  function updatePhotoNote(photoId: string, note: string) {
    setPhotos((current) =>
      current.map((photo) => (photo.id === photoId ? { ...photo, note } : photo)),
    )
  }
  function deletePhoto(photoId: string) {
    const photo = photos.find((item) => item.id === photoId)
    if (!photo) return
    if (!window.confirm(photo.serial + " fotó törlése?")) return
    setPhotos((current) => current.filter((item) => item.id !== photoId))
    setExpandedPhotoId((current) => (current === photoId ? null : current))
    setSaveMessage(photo.serial + " fotó törölve")
  }

  function updatePhotoAppendixLayout(photoId: string, appendixLayout: PhotoAppendixLayout) {
    setPhotos((current) =>
      current.map((photo) => (photo.id === photoId ? { ...photo, appendixLayout } : photo)),
    )
  }

  function updatePhotoAppendixOrientation(photoId: string, appendixOrientation: PhotoAppendixOrientation) {
    setPhotos((current) =>
      current.map((photo) => (photo.id === photoId ? { ...photo, appendixOrientation } : photo)),
    )
  }

