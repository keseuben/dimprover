            <td><strong>${escapeHtml(issue.title || "-")}</strong><small>${escapeHtml(issue.description || "")}</small></td>
            <td>${escapeHtml(issue.location || "-")}</td>
            <td><span class="pill pill-severity">${escapeHtml(issue.severity)}</span></td>
            <td><span class="pill">${escapeHtml(issue.status)}</span></td>
            <td>${escapeHtml(issue.responsible || "-")}<small>${escapeHtml(issue.contractorRepresentative || "")}</small></td>
