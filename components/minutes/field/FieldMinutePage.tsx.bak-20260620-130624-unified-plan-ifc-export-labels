  function buildFieldPdfHtmlForIssues(selectedIssues: FieldIssue[], exportNote = "", selectedSignatureKeys?: string[]) {
    const selectedPhotos = photos.filter((photo) => selectedIssues.some((issue) => issue.id === photo.issueId))
    const selectedPlanLinks = planLinks.filter((link) => selectedIssues.some((issue) => issue.id === link.issueId))
    const photoAppendixBlocks = buildPhotoAppendixSection(selectedPhotos)
    const selectedUrgentCount = selectedIssues.filter((issue) => ["Magas", "Sürgős"].includes(issue.severity)).length
    const selectedOpenCount = selectedIssues.filter((issue) => issue.status !== "Lezárva").length
    function hjToneClass(severity: string, status: string) {
      if (["Lezárva", "Ellenőrizve", "Javítva"].includes(status)) return "hj-closed"
      if (severity === "Sürgős") return "hj-urgent"
      if (severity === "Magas") return "hj-heavy"
      return "hj-normal"
    }

    function markerSeverityClass(severity: string) {
      if (severity === "Azonnali intézkedést igényel" || severity === "Sürgős" || severity === "Kritikus") return "severity-critical"
      if (severity === "Súlyos hiba" || severity === "Magas") return "severity-heavy"
      if (severity === "Javítandó hiba" || severity === "Közepes") return "severity-repair"
      return "severity-note"
    }

    function markerStatusClass(status: string) {
      if (status === "Lezárt" || status === "Lezárva" || status === "Javítva" || status === "Ellenőrizve") return "status-closed"
      if (status === "Ellenőrzésre vár") return "status-review"
      if (status === "Folyamatban") return "status-progress"
      return "status-open"
    }

    function markerDisciplineClass(discipline: string) {
      if (discipline === "mechanical") return "discipline-mechanical"
      if (discipline === "electrical") return "discipline-electrical"
      if (discipline === "technology") return "discipline-technology"
      if (discipline === "other") return "discipline-other"
