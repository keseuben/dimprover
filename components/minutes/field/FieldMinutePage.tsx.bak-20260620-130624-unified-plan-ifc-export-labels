            return `<div class="list-row fhj-row ${hjToneClass(markerSeverity, markerStatus)}"><strong>${escapeHtml(marker.issueSerial || issue.serial)} / ${escapeHtml(marker.serial || "FHJ")}</strong><span><b>Típus:</b> FHJ fotóhely · <b>Kapcsolódó fotó:</b> ${escapeHtml(marker.photoSerial || "-")} · ${escapeHtml(marker.photoName || "fotó")} · <b>Szakág:</b> <em class="discipline-pill ${markerDisciplineClass(marker.discipline)}">${escapeHtml(meta.label)}</em> · <b>Súlyosság:</b> <em class="severity-text ${markerSeverityClass(markerSeverity)}">${escapeHtml(markerSeverity)}</em> · <b>Státusz:</b> <em class="status-text ${markerStatusClass(markerStatus)}">${escapeHtml(markerStatus)}</em> · <b>Határidő:</b> ${escapeHtml(marker.issueDeadline || marker.dueDate || issue.deadline || "-")}<br/><b>Érintett:</b> ${escapeHtml(marker.issueResponsible || marker.responsible || issue.responsible || "-")} · ${escapeHtml(marker.issueContractorRepresentative || issue.contractorRepresentative || "-")}<br/><b>Leírás:</b> ${escapeHtml(marker.photoNote || marker.note || "Fotó készítésének helye a tervlapon.")}<br/><b>Tervlap:</b> ${escapeHtml(marker.pdfFileName || link.planName)} · ${marker.pageNumber || link.pageNumber}. oldal · Fotóhely: külön A4 tervmellékletben</span></div>`
