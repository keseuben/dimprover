  function buildFieldPdfHtml() {
    return buildFieldPdfHtmlForIssues(issues)
  }

  function getMissingPlanCropCount(selectedIssues: FieldIssue[]) {
    return planLinks
      .filter((link) => selectedIssues.some((issue) => issue.id === link.issueId))
      .reduce((count, link) => count + (link.planMarkers ?? []).filter((marker) => !marker.cropImageDataUrl).length, 0)
  }

  function confirmPlanCropExport(selectedIssues: FieldIssue[]) {
    const missingCount = getMissingPlanCropCount(selectedIssues)
    if (!missingCount) return true
    return window.confirm(`${missingCount} db HexPin markerhez még nincs mentett PDF tervrészlet-kép.

Ha most exportálsz, ezeknél a jegyzőkönyvben csak előnézeti rácsos tervhely jelenik meg, nem valódi PDF tervrészlet.

Folytatod így az exportot?`)
  }


  function openFirstMissingPlanCrop() {
    const firstMissingLink = planLinks.find((link) => (link.planMarkers ?? []).some((marker) => !marker.cropImageDataUrl))
    if (!firstMissingLink) {
      setSaveMessage("Nincs hiányzó HexPin tervrészlet-kép")
      return
    }
    setActiveIssueId(firstMissingLink.issueId)
    setActiveTab("plans")
    setOpenRightPanels((current) => ({ ...current, photos: current.photos }))
    setSaveMessage(`Hiányzó tervrészlet-kép megnyitva · ${firstMissingLink.markerLabel}`)
  }

  const planCropAppendixEntries = useMemo(() => {
    return planLinks.flatMap((link) => (link.planMarkers ?? [])
      .filter((marker) => Boolean(marker.cropFrame || marker.cropImageDataUrl))
      .map((marker) => ({
        link,
        marker,
        cropFrame: marker.cropFrame ?? {
          xPercent: 0,
          yPercent: 0,
          widthPercent: 100,
          heightPercent: 100,
          paperSize: marker.paperSize || "A4",
          orientation: marker.orientation || "landscape",
          pageNumber: marker.pageNumber || link.pageNumber || 1,
          pdfFileName: marker.pdfFileName || link.planName,
          generatedAt: marker.cropImageGeneratedAt,
          hexpinExportVersion: marker.cropHexpinExportVersion,
        },
      })))
  }, [planLinks])

  function getPdfTimestampSlug(date = new Date()) {
    const yy = String(date.getFullYear()).slice(-2)
    const mm = String(date.getMonth() + 1).padStart(2, "0")
    const dd = String(date.getDate()).padStart(2, "0")
    const hh = String(date.getHours()).padStart(2, "0")
    const min = String(date.getMinutes()).padStart(2, "0")
    return `${yy}_${mm}${dd}_${hh}${min}`
  }

  function normalizePdfFilenamePart(value: string) {
    return value
      .trim()
      .toLowerCase()
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "")
      .replace(/[^a-z0-9]+/g, "_")
      .replace(/^_+|_+$/g, "")
  }

  function abbreviatePdfFilenamePart(value: string) {
    const normalized = normalizePdfFilenamePart(value)
    const parts = normalized.split("_").filter(Boolean)
    if (parts.length >= 3) return parts.map((part) => part[0]).join("").slice(0, 10)
    return normalized.slice(0, 18)
  }

  function getProjectLocationPdfSlug() {
    return [abbreviatePdfFilenamePart(FIELD_PROJECT_NAME), abbreviatePdfFilenamePart(FIELD_WORK_AREA)].filter(Boolean).join("_")
  }

  function createFieldPdfFilename(kind: "teljes" | "jkv" | "tervreszlet" | "felelos", label?: string) {
    const normalizedLabel = label ? normalizePdfFilenamePart(label).slice(0, 45) : null
    const projectLocationSlug = getProjectLocationPdfSlug()
    const base = ["th", "jkv", kind === "jkv" ? null : kind, projectLocationSlug, normalizedLabel, getPdfTimestampSlug()].filter(Boolean).join("_")
    return `${base}.pdf`
  }

  async function downloadPdfBlob(blob: Blob, filename: string) {
    if (!blob.size) throw new Error("Üres PDF válasz érkezett")
    const url = URL.createObjectURL(blob)
    const link = document.createElement("a")
    link.href = url
    link.download = filename
    link.rel = "noopener"
    document.body.appendChild(link)
    link.click()
    link.remove()
    window.setTimeout(() => URL.revokeObjectURL(url), 30000)
  }

  async function createFieldPdfBlob(selectedIssues: FieldIssue[], exportNote: string, filename: string, selectedSignatureKeys?: string[]) {
    const response = await fetch("/api/minutes/pdf-export", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        html: buildFieldPdfHtmlForIssues(selectedIssues, exportNote, selectedSignatureKeys),
        title: "Terepi hibafelvételi jegyzőkönyv",
        filename,
        showPageNumbers: true,
      }),
    })
    if (!response.ok) throw new Error(await response.text())
    return response.blob()
  }

  async function mergePdfBlobs(parts: (Blob | Uint8Array)[]) {
    const target = await PDFDocument.create()
    for (const part of parts) {
      const bytes = part instanceof Blob ? await part.arrayBuffer() : part
      const source = await PDFDocument.load(bytes, { ignoreEncryption: true })
      const copied = await target.copyPages(source, source.getPageIndices())
      copied.forEach((page) => target.addPage(page))
    }
    const mergedBytes = await target.save()
    const arrayBuffer = new ArrayBuffer(mergedBytes.byteLength)
    new Uint8Array(arrayBuffer).set(mergedBytes)
    return new Blob([arrayBuffer], { type: "application/pdf" })
  }

  async function createPlanCropAppendixBytesForCurrentRecord() {
    if (!planCropAppendixEntries.length) return null
    return createPlanCropAppendixPdf(planCropAppendixEntries, {
      recordDate,
      documentLabel: "Terepi hibafelvételi tervrészlet melléklet",
    })
  }

  async function exportPlanCropAppendixPdf() {
    if (!planCropAppendixEntries.length) {
      window.alert("Nincs olyan HJ marker, amelyhez mentett tervrészlet-kép vagy kivágási keret tartozik. Előbb ments képet a közös tervnézőben.")
      return
    }
    setIsExporting(true)
    setSaveMessage("A4 tervrészlet-melléklet PDF készül · mentett IFC/PDF képekkel")
    try {
      const bytes = await createPlanCropAppendixPdf(planCropAppendixEntries, {
        recordDate,
        documentLabel: "Terepi hibafelvételi tervrészlet melléklet",
      })
      const blob = new Blob([bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength) as ArrayBuffer], { type: "application/pdf" })
      const url = URL.createObjectURL(blob)
      const a = document.createElement("a")
      a.href = url
      a.download = createFieldPdfFilename("tervreszlet")
      a.rel = "noopener"
      document.body.appendChild(a)
      a.click()
      a.remove()
      window.setTimeout(() => URL.revokeObjectURL(url), 30000)
      setSaveMessage("A4 tervrészlet-melléklet PDF elkészült · 2 tervrészlet / oldal")
    } catch (error) {
      console.error(error)
      const message = error instanceof Error ? error.message : "Tervrészlet melléklet PDF export hiba"
      setSaveMessage(message.slice(0, 120))
      window.alert(`Tervrészlet melléklet PDF export hiba: ${message}`)
    } finally {
      setIsExporting(false)
    }
  }

