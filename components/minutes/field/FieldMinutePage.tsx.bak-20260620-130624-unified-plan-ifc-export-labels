        const issuePhotoMarkers = issuePlanLinks.flatMap((link) =>
          (link.planMarkers ?? [])
            .filter((marker) => marker.markerKind === "photo" && marker.issueId === issue.id)
            .map((marker) => ({ link, marker, meta: getPlanIssueDisciplineMeta(marker.discipline) })),
        )
        const planNames = Array.from(new Set(issuePlanLinks.map((link) => link.planName))).join(", ") || "-"
        const markerRows = issueMarkers.length || issuePhotoMarkers.length
          ? [
            ...issueMarkers.map(({ marker, meta }) => {
              const markerSeverity = marker.issueSeverity || issue.severity
              const markerStatus = marker.status || marker.issueStatus || issue.status
              return `
              <tr class="hj-row ${hjToneClass(markerSeverity, markerStatus)}">
                <td></td>
