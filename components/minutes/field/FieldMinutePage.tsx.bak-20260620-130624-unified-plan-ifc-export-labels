function getPlanUploadFileKind(file: File) {
  const lowerName = file.name.toLowerCase()
  if (file.type === "application/pdf" || lowerName.endsWith(".pdf")) return "pdf"
  if (lowerName.endsWith(".ifc")) return "ifc"
  if (lowerName.endsWith(".dwg")) return "dwg"
  if (lowerName.endsWith(".dxf")) return "dxf"
  if (file.type.startsWith("image/") || [".png", ".jpg", ".jpeg", ".webp"].some((extension) => lowerName.endsWith(extension))) return "image"
  return null
}

function getPlanUploadKindLabel(kind: string) {
  if (kind === "ifc") return "IFC modell"
