    const grouped = appendixPhotos.reduce<Record<string, FieldPhoto[]>>((acc, photo) => {
      const key = `${photo.appendixLayout || "half"}-${photo.appendixOrientation || "portrait"}`
      acc[key] = acc[key] || []
      acc[key].push(photo)
      return acc
    }, {})

    const titleForLayout = (layout: PhotoAppendixLayout, orientation: PhotoAppendixOrientation) => {
      const sizeLabel = layout === "quarter" ? "1/4 oldal" : layout === "half" ? "1/2 oldal" : "1/1 oldal"
      const orientationLabel = orientation === "landscape" ? "fekvő képelhelyezés" : "álló képelhelyezés"
      return `Nagyított fotómellékletek · ${sizeLabel} · ${orientationLabel}`
    }

    const renderGroup = (layout: PhotoAppendixLayout, orientation: PhotoAppendixOrientation, photosForLayout: FieldPhoto[]) => {
      if (!photosForLayout.length) return ""
      return `<section class="appendix-section appendix-${layout} appendix-${orientation}"><h2>${titleForLayout(layout, orientation)}</h2><div class="appendix-grid">${photosForLayout
        .map(
