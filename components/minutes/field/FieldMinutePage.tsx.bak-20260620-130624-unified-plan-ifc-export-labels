function PhotoMarkupEditor({
  photo,
  onSave,
  onCancel,
}: {
  photo: FieldPhoto
  onSave: (dataUrl: string) => void
  onCancel: () => void
}) {
  const canvasRef = useRef<HTMLCanvasElement | null>(null)
  const stageRef = useRef<HTMLDivElement | null>(null)
  const shapeStartRef = useRef<{ x: number; y: number } | null>(null)
  const baseSnapshotRef = useRef<string>("")
  const dragRef = useRef<{ id: string; dx: number; dy: number } | null>(null)
  const panRef = useRef<{ x: number; y: number; left: number; top: number } | null>(null)
  const activePointersRef = useRef<Map<number, { x: number; y: number }>>(new Map())
  const pinchRef = useRef<{ distance: number; zoom: number } | null>(null)
  const draftPenRef = useRef<Array<{ x: number; y: number }>>([])
  const [isDrawing, setIsDrawing] = useState(false)
  const [tool, setTool] = useState<MarkupTool>("pen")
  const [viewMode, setViewMode] = useState<"pan" | "select">("select")
  const [color, setColor] = useState("#dc2626")
  const [lineWidth, setLineWidth] = useState(8)
  const [text, setText] = useState("")
  const [textBackgroundColor, setTextBackgroundColor] = useState("#fef08a")
  const [items, setItems] = useState<MarkupItem[]>([])
  const [selectedItemId, setSelectedItemId] = useState<string | null>(null)
  const [history, setHistory] = useState<MarkupSnapshot[]>([])
  const [zoom, setZoom] = useState(1)
  const [autoFitImage, setAutoFitImage] = useState(true)
  const [showColorPalette, setShowColorPalette] = useState(false)
  const [baseImageLoaded, setBaseImageLoaded] = useState(false)


  const markupTools: Array<{ value: MarkupTool; label: string; icon: string }> = [
    { value: "pen", label: "Toll", icon: "✎" },
    { value: "arrow", label: "Nyíl", icon: "↗" },
    { value: "circle", label: "Szaggatott kör", icon: "◌" },
    { value: "rect", label: "Téglalap", icon: "▭" },
    { value: "hexagon", label: "Hexagon", icon: "⬡" },
    { value: "text", label: "Szöveg", icon: "T" },
  ]

  const markupColors = [
    "#dc2626", "#facc15", "#a855f7", "#2563eb", "#16a34a", "#f59e0b", "#ec4899", "#06b6d4", "#111827", "#ffffff",
  ]

  const textBackgroundColors = ["transparent", "#fef08a", "#ffffff", "#dcfce7", "#dbeafe", "#fce7f3", "#111827"]

  function withContext(callback: (canvas: HTMLCanvasElement, context: CanvasRenderingContext2D) => void) {
    const canvas = canvasRef.current
    const context = canvas?.getContext("2d")
    if (!canvas || !context) return
    callback(canvas, context)
  }

  function fitImageToStage() {
    const canvas = canvasRef.current
    const stage = stageRef.current
    if (!canvas || !stage) return
    const availableWidth = Math.max(320, stage.clientWidth - 36)
    const availableHeight = Math.max(240, stage.clientHeight - 36)
    const nextZoom = Math.min(1, Math.max(0.12, Number(Math.min(availableWidth / canvas.width, availableHeight / canvas.height).toFixed(2))))
    setZoom(nextZoom)
  }

  function drawHexagonPath(context: CanvasRenderingContext2D, x: number, y: number, width: number, height: number) {
    const left = x
    const right = x + width
    const top = y
    const bottom = y + height
    const midY = y + height / 2
    const cut = Math.abs(width) * 0.22
    context.beginPath()
    context.moveTo(left + cut, top)
    context.lineTo(right - cut, top)
    context.lineTo(right, midY)
    context.lineTo(right - cut, bottom)
    context.lineTo(left + cut, bottom)
    context.lineTo(left, midY)
    context.closePath()
  }

  function drawItem(context: CanvasRenderingContext2D, item: MarkupItem, selected = false) {
    context.save()
    context.strokeStyle = item.color
    context.fillStyle = item.color
    context.lineWidth = item.lineWidth
    context.lineCap = "round"
    context.lineJoin = "round"

    if (item.type === "pen") {
      const points = item.points || []
      if (points.length) {
        context.beginPath()
        context.moveTo(points[0].x, points[0].y)
        points.slice(1).forEach((point) => context.lineTo(point.x, point.y))
        context.stroke()
      }
    }

    if (item.type === "arrow") {
      const to = { x: item.x2 ?? item.x, y: item.y2 ?? item.y }
      const angle = Math.atan2(to.y - item.y, to.x - item.x)
      const headLength = Math.max(18, item.lineWidth * 4)
      context.beginPath()
      context.moveTo(item.x, item.y)
      context.lineTo(to.x, to.y)
      context.stroke()
      context.beginPath()
      context.moveTo(to.x, to.y)
      context.lineTo(to.x - headLength * Math.cos(angle - Math.PI / 6), to.y - headLength * Math.sin(angle - Math.PI / 6))
      context.moveTo(to.x, to.y)
      context.lineTo(to.x - headLength * Math.cos(angle + Math.PI / 6), to.y - headLength * Math.sin(angle + Math.PI / 6))
      context.stroke()
    }

    if (item.type === "circle") {
      const x2 = item.x2 ?? item.x
      const y2 = item.y2 ?? item.y
      context.setLineDash([18, 12])
      context.beginPath()
      context.ellipse(item.x + (x2 - item.x) / 2, item.y + (y2 - item.y) / 2, Math.abs((x2 - item.x) / 2), Math.abs((y2 - item.y) / 2), 0, 0, Math.PI * 2)
      context.stroke()
    }


    if (item.type === "rect") {
      const x2 = item.x2 ?? item.x
      const y2 = item.y2 ?? item.y
      const x = Math.min(item.x, x2)
      const y = Math.min(item.y, y2)
      context.setLineDash([18, 12])
      context.strokeRect(x, y, Math.abs(x2 - item.x), Math.abs(y2 - item.y))
    }

    if (item.type === "hexagon") {
      const x2 = item.x2 ?? item.x
      const y2 = item.y2 ?? item.y
      const x = Math.min(item.x, x2)
      const y = Math.min(item.y, y2)
      const width = Math.abs(x2 - item.x)
      const height = Math.abs(y2 - item.y)
      context.setLineDash([18, 12])
      drawHexagonPath(context, x, y, width, height)
      context.stroke()
    }

    if (item.type === "text") {
      const fontSize = Math.max(24, item.lineWidth * 7)
      const textValue = item.text || ""
      context.font = `bold ${fontSize}px Arial`
      const textWidth = Math.max(40, context.measureText(textValue).width)
      if (item.textBackgroundColor && item.textBackgroundColor !== "transparent") {
        context.fillStyle = item.textBackgroundColor
        context.fillRect(item.x - 10, item.y - fontSize - 8, textWidth + 20, fontSize + 18)
      }
      context.fillStyle = item.color
      context.fillText(textValue, item.x, item.y)
    }

    if (selected) {
      context.setLineDash([8, 6])
      context.strokeStyle = "#0f172a"
      context.lineWidth = 2
      const box = getItemBox(item)
      context.strokeRect(box.x - 8, box.y - 8, box.w + 16, box.h + 16)
    }
    context.restore()
  }

  function getItemBox(item: MarkupItem) {
    const padding = Math.max(28, item.lineWidth * 3)
    if (item.type === "text") {
      const fontSize = Math.max(24, item.lineWidth * 7)
      const textWidth = Math.max(180, (item.text || "").length * fontSize * 0.72)
      const touchPadding = Math.max(42, padding * 1.8)
      return { x: item.x - touchPadding, y: item.y - fontSize - touchPadding, w: textWidth + touchPadding * 2, h: fontSize + touchPadding * 2 }
    }
    if (item.type === "pen" && item.points?.length) {
      const xs = item.points.map((point) => point.x)
      const ys = item.points.map((point) => point.y)
      const x = Math.min(...xs)
      const y = Math.min(...ys)
      return { x: x - padding, y: y - padding, w: Math.max(32, Math.max(...xs) - x) + padding * 2, h: Math.max(32, Math.max(...ys) - y) + padding * 2 }
    }
    const x2 = item.x2 ?? item.x
    const y2 = item.y2 ?? item.y
    const x = Math.min(item.x, x2)
    const y = Math.min(item.y, y2)
    return { x: x - padding, y: y - padding, w: Math.max(36, Math.abs(x2 - item.x)) + padding * 2, h: Math.max(36, Math.abs(y2 - item.y)) + padding * 2 }
  }

  function drawBaseSync(context: CanvasRenderingContext2D, canvas: HTMLCanvasElement) {
    if (!baseSnapshotRef.current) return false
    const image = new Image()
    image.src = baseSnapshotRef.current
    if (!image.complete) return false
    context.clearRect(0, 0, canvas.width, canvas.height)
    context.drawImage(image, 0, 0, canvas.width, canvas.height)
    return true
  }

  function redraw(withSelection = true) {
    withContext((canvas, context) => {
      const image = new Image()
      image.onload = () => {
        context.clearRect(0, 0, canvas.width, canvas.height)
        context.drawImage(image, 0, 0, canvas.width, canvas.height)
        items.forEach((item) => drawItem(context, item, withSelection && item.id === selectedItemId))
      }
      image.src = baseSnapshotRef.current || photo.dataUrl
    })
  }

  useEffect(() => {
    if (!photo.dataUrl) return
    const image = new Image()
    image.onload = () => {
      withContext((canvas, context) => {
        canvas.width = Math.max(600, image.width)
        canvas.height = Math.max(360, image.height)
        context.clearRect(0, 0, canvas.width, canvas.height)
        context.drawImage(image, 0, 0, canvas.width, canvas.height)
        const snapshot = canvas.toDataURL("image/jpeg", 0.86)
        baseSnapshotRef.current = snapshot
        setBaseImageLoaded(true)
        setHistory([{ dataUrl: snapshot }])
        window.setTimeout(fitImageToStage, 80)
      })
    }
    image.src = photo.dataUrl
  }, [photo.dataUrl])

  useEffect(() => {
    redraw(true)
  }, [items, selectedItemId])

  useEffect(() => {
    if (!autoFitImage || !baseImageLoaded) return
    fitImageToStage()
    function handleResize() {
      fitImageToStage()
    }
    window.addEventListener("resize", handleResize)
    return () => window.removeEventListener("resize", handleResize)
  }, [autoFitImage, baseImageLoaded])

  function pushHistory() {
    withContext((canvas) => setHistory((current) => [...current.slice(-19), { dataUrl: canvas.toDataURL("image/jpeg", 0.86) }]))
  }

  function undo() {
    setHistory((current) => {
      if (current.length <= 1) return current
      const next = current.slice(0, -1)
      const last = next[next.length - 1]
      withContext((canvas, context) => {
        const image = new Image()
        image.onload = () => {
          context.clearRect(0, 0, canvas.width, canvas.height)
          context.drawImage(image, 0, 0, canvas.width, canvas.height)
          baseSnapshotRef.current = image.src
          setItems([])
          setSelectedItemId(null)
        }
        image.src = last.dataUrl
      })
      return next
    })
  }

  function clearMarkup() {
    setItems([])
    setSelectedItemId(null)
    if (photo.dataUrl) {
      baseSnapshotRef.current = photo.dataUrl
      const image = new Image()
      image.onload = () => {
        withContext((canvas, context) => {
          context.clearRect(0, 0, canvas.width, canvas.height)
          context.drawImage(image, 0, 0, canvas.width, canvas.height)
          setHistory([{ dataUrl: canvas.toDataURL("image/jpeg", 0.86) }])
        })
      }
      image.src = photo.dataUrl
    }
  }

  function deleteSelected() {
    if (!selectedItemId) return
    setItems((current) => current.filter((item) => item.id !== selectedItemId))
    setSelectedItemId(null)
    setTimeout(pushHistory, 0)
  }

  function getPos(event: React.PointerEvent<HTMLCanvasElement>) {
    const canvas = canvasRef.current
    if (!canvas) return { x: 0, y: 0 }
    const rect = canvas.getBoundingClientRect()
    return {
      x: ((event.clientX - rect.left) / rect.width) * canvas.width,
      y: ((event.clientY - rect.top) / rect.height) * canvas.height,
    }
  }

  function distanceToSegment(point: { x: number; y: number }, start: { x: number; y: number }, end: { x: number; y: number }) {
    const lengthSq = (end.x - start.x) ** 2 + (end.y - start.y) ** 2
    if (!lengthSq) return Math.hypot(point.x - start.x, point.y - start.y)
    const t = Math.max(0, Math.min(1, ((point.x - start.x) * (end.x - start.x) + (point.y - start.y) * (end.y - start.y)) / lengthSq))
    const projection = { x: start.x + t * (end.x - start.x), y: start.y + t * (end.y - start.y) }
    return Math.hypot(point.x - projection.x, point.y - projection.y)
  }

  function getItemHitDistance(pos: { x: number; y: number }, item: MarkupItem) {
    const box = getItemBox(item)
    const insideBox = pos.x >= box.x && pos.x <= box.x + box.w && pos.y >= box.y && pos.y <= box.y + box.h
    if (!insideBox) return Number.POSITIVE_INFINITY

    if (item.type === "text") return 0
    if (item.type === "arrow") return distanceToSegment(pos, { x: item.x, y: item.y }, { x: item.x2 ?? item.x, y: item.y2 ?? item.y })
    if (item.type === "pen" && item.points?.length) {
      if (item.points.length === 1) return Math.hypot(pos.x - item.points[0].x, pos.y - item.points[0].y)
      return Math.min(...item.points.slice(1).map((point, index) => distanceToSegment(pos, item.points![index], point)))
    }
    if (item.type === "circle") {
      const x2 = item.x2 ?? item.x
      const y2 = item.y2 ?? item.y
      const centerX = item.x + (x2 - item.x) / 2
      const centerY = item.y + (y2 - item.y) / 2
      const radiusX = Math.max(12, Math.abs((x2 - item.x) / 2))
      const radiusY = Math.max(12, Math.abs((y2 - item.y) / 2))
      const normalized = Math.sqrt(((pos.x - centerX) / radiusX) ** 2 + ((pos.y - centerY) / radiusY) ** 2)
      if (normalized <= 1.18) return 0
      return Math.abs(normalized - 1) * Math.max(radiusX, radiusY)
    }
    if (item.type === "rect" || item.type === "hexagon") return insideBox ? 0 : Number.POSITIVE_INFINITY
    return Number.POSITIVE_INFINITY
  }

  function findItemAt(pos: { x: number; y: number }) {
    const threshold = Math.max(44, 64 / zoom)
    const hits = items
      .map((item, index) => ({ item, index, distance: getItemHitDistance(pos, item) }))
      .filter((hit) => hit.distance <= threshold)
      .sort((a, b) => (a.distance === 0 && b.distance === 0 ? b.index - a.index : a.distance - b.distance || b.index - a.index))
    return hits[0]?.item
  }

  function selectMarkupItem(item: MarkupItem) {
    setSelectedItemId(item.id)
    setColor(item.color)
    setLineWidth(item.lineWidth)
    if (item.type === "text") {
      setText(item.text || "")
      setTextBackgroundColor(item.textBackgroundColor || "transparent")
      setTool("text")
    }
  }

  function begin(event: React.PointerEvent<HTMLCanvasElement>) {
    const canvas = canvasRef.current
    const context = canvas?.getContext("2d")
    if (!canvas || !context) return
    event.currentTarget.setPointerCapture(event.pointerId)
    if (!isDrawing) {
      activePointersRef.current.clear()
      pinchRef.current = null
    }
    activePointersRef.current.set(event.pointerId, { x: event.clientX, y: event.clientY })
    if (activePointersRef.current.size === 2) {
      const points = [...activePointersRef.current.values()]
      pinchRef.current = { distance: Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y), zoom }
      setIsDrawing(true)
      return
    }
    const pos = getPos(event)
    setShowColorPalette(false)

    if (viewMode === "pan") {
      const stage = stageRef.current
      if (stage) panRef.current = { x: event.clientX, y: event.clientY, left: stage.scrollLeft, top: stage.scrollTop }
      setIsDrawing(true)
      return
    }

    if (viewMode === "select" || tool === "text") {
      const hit = findItemAt(pos)
      if (hit) {
        selectMarkupItem(hit)
        dragRef.current = { id: hit.id, dx: pos.x - hit.x, dy: pos.y - hit.y }
        setIsDrawing(true)
        return
      }
      setSelectedItemId(null)
    }

    if (tool === "text") return

    pushHistory()
    shapeStartRef.current = pos
    if (tool === "pen") {
      draftPenRef.current = [pos]
    }
    setIsDrawing(true)
  }

  function move(event: React.PointerEvent<HTMLCanvasElement>) {
    if (!isDrawing) return
    const canvas = canvasRef.current
    const context = canvas?.getContext("2d")
    if (!canvas || !context) return
    activePointersRef.current.set(event.pointerId, { x: event.clientX, y: event.clientY })
    if (pinchRef.current && activePointersRef.current.size >= 2) {
      const points = [...activePointersRef.current.values()].slice(0, 2)
      const distance = Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y)
      const nextZoom = Math.min(4, Math.max(0.35, Number((pinchRef.current.zoom * (distance / Math.max(1, pinchRef.current.distance))).toFixed(2))))
      setZoom(nextZoom)
      return
    }
    const pos = getPos(event)

    if (viewMode === "pan" && panRef.current && stageRef.current) {
      stageRef.current.scrollLeft = panRef.current.left - (event.clientX - panRef.current.x)
      stageRef.current.scrollTop = panRef.current.top - (event.clientY - panRef.current.y)
      return
    }

    if (dragRef.current) {
      const drag = dragRef.current
      setItems((current) => current.map((item) => {
        if (item.id !== drag.id) return item
        const nextX = pos.x - drag.dx
        const nextY = pos.y - drag.dy
        const deltaX = nextX - item.x
        const deltaY = nextY - item.y
        return {
          ...item,
          x: nextX,
          y: nextY,
          ...(item.x2 !== undefined ? { x2: item.x2 + deltaX } : {}),
          ...(item.y2 !== undefined ? { y2: item.y2 + deltaY } : {}),
          ...(item.points ? { points: item.points.map((point) => ({ x: point.x + deltaX, y: point.y + deltaY })) } : {}),
        }
      }))
      return
    }

    if (tool === "pen") {
      const previous = draftPenRef.current[draftPenRef.current.length - 1]
      draftPenRef.current = [...draftPenRef.current, pos]
      if (previous) {
        context.save()
        context.strokeStyle = color
        context.lineWidth = lineWidth
        context.lineCap = "round"
        context.lineJoin = "round"
        context.beginPath()
        context.moveTo(previous.x, previous.y)
        context.lineTo(pos.x, pos.y)
        context.stroke()
        context.restore()
      }
      return
    }

    const start = shapeStartRef.current
    if (!start || !["arrow", "circle", "rect", "hexagon"].includes(tool)) return
    if (baseImageLoaded) {
      drawBaseSync(context, canvas)
      items.forEach((item) => drawItem(context, item, false))
    }
    const preview: MarkupItem = { id: "preview", type: tool as "arrow" | "circle" | "rect" | "hexagon", color, lineWidth, x: start.x, y: start.y, x2: pos.x, y2: pos.y }
    drawItem(context, preview)
  }

  function end(event?: React.PointerEvent<HTMLCanvasElement>) {
    if (!isDrawing) return
    if (event) activePointersRef.current.delete(event.pointerId)
    if (activePointersRef.current.size < 2) pinchRef.current = null
    const pos = event ? getPos(event) : null
    const start = shapeStartRef.current

    if (tool === "pen" && draftPenRef.current.length) {
      const points = draftPenRef.current
      const item: MarkupItem = { id: `markup-${Date.now()}`, type: "pen", color, lineWidth, x: points[0].x, y: points[0].y, points }
      setItems((current) => [...current, item])
      setSelectedItemId(item.id)
      draftPenRef.current = []
      setTimeout(pushHistory, 0)
    }

    if (start && pos && ["arrow", "circle", "rect", "hexagon"].includes(tool)) {
      const item: MarkupItem = { id: `markup-${Date.now()}`, type: tool as "arrow" | "circle" | "rect" | "hexagon", color, lineWidth, x: start.x, y: start.y, x2: pos.x, y2: pos.y }
      setItems((current) => [...current, item])
      setSelectedItemId(item.id)
      setTimeout(pushHistory, 0)
    }

    if (dragRef.current) setTimeout(pushHistory, 0)
    shapeStartRef.current = null
    dragRef.current = null
    panRef.current = null
    if (activePointersRef.current.size === 0) {
      pinchRef.current = null
    }
    setIsDrawing(false)
  }

  function addText() {
    const selectedTextItem = items.find((item) => item.id === selectedItemId && item.type === "text")
    const nextText = (text || selectedTextItem?.text || "").trim()
    if (!nextText) return
    if (selectedTextItem) {
      setItems((current) => current.map((item) => (item.id === selectedTextItem.id ? { ...item, text: nextText, color, lineWidth, textBackgroundColor } : item)))
      setTimeout(pushHistory, 0)
      return
    }
    const item: MarkupItem = { id: `markup-${Date.now()}`, type: "text", color, lineWidth, x: 60, y: 80, text: nextText, textBackgroundColor }
    setItems((current) => [...current, item])
    setSelectedItemId(item.id)
    setText("")
    setTool("text")
    setViewMode("select")
    setTimeout(pushHistory, 0)
  }

  const selectedTextItem = items.find((item) => item.id === selectedItemId && item.type === "text")

  function flattenSelection() {
    redraw(false)
  }

  function save() {
    flattenSelection()
    const canvas = canvasRef.current
    if (!canvas) return
    window.setTimeout(() => {
      onSave(canvas.toDataURL("image/jpeg", 0.76))
      onCancel()
    }, 50)
  }

  function changeZoom(delta: number) {
    setAutoFitImage(false)
    setZoom((current) => Math.min(4, Math.max(0.12, Number((current + delta).toFixed(2)))))
  }

  function resetZoom() {
    setAutoFitImage(false)
    setZoom(1)
  }

  function applyColor(nextColor: string) {
    setColor(nextColor)
    if (selectedItemId) {
      setItems((current) => current.map((item) => (item.id === selectedItemId ? { ...item, color: nextColor } : item)))
      setTimeout(pushHistory, 0)
    }
  }

  function applyLineWidth(nextLineWidth: number) {
    setLineWidth(nextLineWidth)
    if (selectedItemId) {
      setItems((current) => current.map((item) => (item.id === selectedItemId ? { ...item, lineWidth: nextLineWidth } : item)))
      setTimeout(pushHistory, 0)
    }
  }

  useEffect(() => {
    function handleKeyDown(event: KeyboardEvent) {
      if ((event.key === "Delete" || event.key === "Backspace") && selectedItemId) {
        event.preventDefault()
        deleteSelected()
      }
    }
    window.addEventListener("keydown", handleKeyDown)
    return () => window.removeEventListener("keydown", handleKeyDown)
  }, [selectedItemId])

  return (
    <div className="fixed inset-0 z-[9999] bg-slate-950/80 p-2 backdrop-blur sm:p-4">
      <div className="markup-editor-shell mx-auto flex h-[calc(100vh-1rem)] max-w-[calc(100vw-1rem)] flex-col overflow-hidden border border-slate-200 bg-white shadow-2xl sm:h-[calc(100vh-2rem)] sm:max-w-[calc(100vw-2rem)]">
        <div className="markup-header flex shrink-0 items-center justify-between border-b border-slate-200 p-2 sm:p-3">
          <div>
            <div className="text-sm font-black text-slate-900">Képszerkesztő</div>
            <div className="hidden text-xs font-semibold text-slate-500 sm:block">Kijelölés, mozgatás, nyíl, szaggatott karika, téglalap, hexagon, toll, szöveg + háttér.</div>
          </div>
          <div className="flex h-6 items-center gap-2 overflow-hidden">
            {selectedItemId ? <span className="hidden border border-orange-200 bg-orange-50 px-2 py-1 text-[10px] font-black uppercase text-orange-700 sm:inline">Kijelölt elem törölhető</span> : null}
            <button type="button" onClick={save} className="border border-cyan-700 bg-cyan-700 px-3 py-2 text-xs font-black uppercase text-white">Mentés és vissza</button>
            <button type="button" onClick={onCancel} className="border border-slate-200 px-3 py-2 text-xs font-black uppercase">Bezárás</button>
          </div>
        </div>
        <div className="markup-tool-row flex shrink-0 items-center gap-2 overflow-visible border-b border-slate-200 p-2">
          <button type="button" onClick={() => { setViewMode("select"); setTool("pen"); setShowColorPalette(false) }} className={`grid h-12 min-w-16 place-items-center border px-2 text-[10px] font-black uppercase ${viewMode === "select" ? "border-cyan-700 bg-emerald-50 text-cyan-800" : "border-slate-200 text-slate-700"}`} aria-label="Kijelölés"><span className="block text-[9px] leading-3">Kijelölés</span><span className="text-sm">⌖</span></button>
          {markupTools.map((item) => (
            <button key={item.value} type="button" onClick={() => { setTool(item.value); setViewMode("select"); if (item.value !== "text") setSelectedItemId(null); setShowColorPalette(false) }} className={`grid h-12 min-w-16 place-items-center border px-2 font-black ${tool === item.value && viewMode === "select" ? "border-cyan-700 bg-emerald-50 text-cyan-800" : "border-slate-200 text-slate-700"}`} aria-label={item.label} title={item.label}>
              <span className="block text-[9px] uppercase leading-3">{item.label}</span><span className="text-lg leading-5">{item.icon}</span>
            </button>
          ))}
          <select value={lineWidth} onChange={(event) => applyLineWidth(Number(event.target.value))} className="h-10 border border-slate-200 bg-white px-2 text-xs font-black uppercase">
            <option value={4}>Vékony</option>
            <option value={8}>Közepes</option>
            <option value={14}>Vastag</option>
            <option value={22}>Extra</option>
          </select>
          <div className="relative ml-auto">
            <button type="button" onClick={() => setShowColorPalette((value) => !value)} className="flex h-10 items-center gap-2 border border-slate-200 bg-white px-2 text-xs font-black uppercase">
              <span className="h-7 w-7 border border-slate-300" style={{ background: color }} />
              Szín
            </button>
            {showColorPalette && (
              <div className="absolute right-0 top-11 z-30 flex gap-1 border border-slate-200 bg-white p-2 shadow-xl">
                {markupColors.map((item) => (
                  <button key={item} type="button" onClick={() => { applyColor(item); setShowColorPalette(false) }} className={`h-8 w-8 border ${color === item ? "border-slate-900" : "border-slate-200"}`} style={{ background: item }} aria-label={`Szín ${item}`} />
                ))}
              </div>
            )}
          </div>
        </div>
        {tool === "text" && (
          <div className="flex shrink-0 flex-wrap items-center gap-2 border-b border-slate-200 p-2 sm:p-3">
            <input value={selectedTextItem && !text ? selectedTextItem.text || "" : text} onChange={(event) => setText(event.target.value)} placeholder={selectedTextItem ? "Kijelölt szöveg módosítása" : "Ráírandó szöveg"} className="h-10 min-w-64 flex-1 border border-slate-200 px-3 text-sm font-semibold outline-none" />
            <div className="flex items-center gap-1 border border-slate-200 bg-slate-50 px-2 py-1">
              <span className="mr-1 text-[10px] font-black uppercase text-slate-500">Háttér</span>
              {textBackgroundColors.map((item) => (
                <button key={item} type="button" onClick={() => setTextBackgroundColor(item)} className={`h-7 w-7 border ${textBackgroundColor === item ? "border-slate-900" : "border-slate-200"}`} style={{ background: item === "transparent" ? "linear-gradient(135deg,#fff 0 45%,#ef4444 46% 54%,#fff 55% 100%)" : item }} aria-label={`Szöveg háttér ${item}`} />
              ))}
            </div>
            <button type="button" onClick={addText} className="border border-slate-200 px-3 py-2 text-xs font-black uppercase">{selectedTextItem ? "Szöveg módosítása" : "Szöveg hozzáadása"}</button>
          </div>
        )}
        <div className="markup-stage-shell relative flex min-h-0 flex-1 flex-col bg-slate-100">
          <div className="absolute left-2 top-2 z-10 flex gap-2 rounded-xl bg-white/90 p-1 shadow-lg backdrop-blur">
            <button type="button" onClick={() => { setViewMode("pan"); setShowColorPalette(false) }} className={`rounded-lg px-3 py-2 text-xs font-black uppercase ${viewMode === "pan" ? "bg-cyan-700 text-white" : "bg-white text-slate-700"}`}>Mozgatás</button>
            <button type="button" onClick={() => { setViewMode("select"); setShowColorPalette(false) }} className={`rounded-lg px-3 py-2 text-xs font-black uppercase ${viewMode === "select" ? "bg-cyan-700 text-white" : "bg-white text-slate-700"}`}>Kijelölés</button>
          </div>
          <div className="absolute right-2 top-2 z-10 flex gap-1 rounded-xl bg-white/90 p-1 shadow-lg backdrop-blur">
            <button type="button" onClick={() => changeZoom(-0.25)} className="rounded-lg bg-white px-3 py-2 text-xs font-black">−</button>
            <button type="button" onClick={resetZoom} className="rounded-lg bg-white px-3 py-2 text-xs font-black">{Math.round(zoom * 100)}%</button>
            <button type="button" onClick={() => changeZoom(0.25)} className="rounded-lg bg-white px-3 py-2 text-xs font-black">+</button>
            <button type="button" onClick={() => { setAutoFitImage(true); fitImageToStage() }} className="rounded-lg bg-cyan-50 px-3 py-2 text-xs font-black text-cyan-800">Teljes kép</button>
          </div>
          <div ref={stageRef} className="markup-canvas-scroll min-h-0 flex-1 overflow-auto p-1 pt-14 touch-pan-x touch-pan-y sm:p-3 sm:pt-16">
            <div style={{ width: `${(canvasRef.current?.width || 600) * zoom}px`, height: `${(canvasRef.current?.height || 360) * zoom}px` }} className="mx-auto">
              <canvas ref={canvasRef} onPointerDown={begin} onPointerMove={move} onPointerUp={end} onPointerCancel={end} onPointerLeave={end} style={{ transform: `scale(${zoom})`, transformOrigin: "top left" }} className="max-w-none touch-none border border-slate-300 bg-white" />
            </div>
          </div>
          <div className="markup-action-row flex shrink-0 items-center gap-2 border-t border-slate-200 bg-white p-2">
