    try {
      const response = await fetch("/api/minutes/pdf-export", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          html: buildFieldPdfHtmlForIssues(selectedIssues, exportNote, selectedSignatureKeys),
          title: "Terepi hibafelvételi jegyzőkönyv",
          filename,
          showPageNumbers: true,
        }),
      })
      if (!response.ok) throw new Error(await response.text())
      const blob = await response.blob()
      if (!blob.size) throw new Error("Üres PDF válasz érkezett")
      const url = URL.createObjectURL(blob)
      const link = document.createElement("a")
      link.href = url
      link.download = filename
      link.rel = "noopener"
      document.body.appendChild(link)
      link.click()
      link.remove()
      window.setTimeout(() => URL.revokeObjectURL(url), 30000)
      setSaveMessage("PDF export elkészült · letöltés indítva")
    } catch (error) {
      console.error(error)
      const message = error instanceof Error ? error.message : "PDF export hiba"
      setSaveMessage(message.slice(0, 120))
      window.alert(`PDF export hiba: ${message}`)
    } finally {
      setIsExporting(false)
    }
  }

  async function exportFieldPdf() {
    if (!confirmPlanCropExport(issues)) {
      setSaveMessage("PDF export megszakítva · hiányzó tervrészlet-kép")
      return
    }
    setIsExporting(true)
    setSaveMessage(planCropAppendixEntries.length ? "Teljes PDF csomag készül · jegyzőkönyv + tervrészlet melléklet" : "PDF export készül")
    try {
      const mainBlob = await createFieldPdfBlob(issues, "", createFieldPdfFilename("jkv"))
      const appendixBytes = await createPlanCropAppendixBytesForCurrentRecord()
      const finalBlob = appendixBytes ? await mergePdfBlobs([mainBlob, appendixBytes]) : mainBlob
      await downloadPdfBlob(finalBlob, appendixBytes ? createFieldPdfFilename("teljes") : createFieldPdfFilename("jkv"))
      setSaveMessage(appendixBytes ? "Teljes PDF elkészült · jegyzőkönyv + tervrészlet melléklet egy fájlban" : "PDF export elkészült · letöltés indítva")
    } catch (error) {
      console.error(error)
      const message = error instanceof Error ? error.message : "PDF export hiba"
      setSaveMessage(message.slice(0, 120))
      window.alert(`PDF export hiba: ${message}`)
    } finally {
      setIsExporting(false)
    }
  }

  async function exportResponsiblePdfForGroup(group: (typeof responsibleGroups)[number]) {
    const safeName = normalizePdfFilenamePart(group.responsible).slice(0, 45)
    const response = await fetch("/api/minutes/pdf-export", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        html: buildFieldPdfHtmlForIssues(group.issues, `Érintett: ${group.responsible}`, [group.responsible]),
        title: `Terepi hibafelvétel - ${group.responsible}`,
        filename: createFieldPdfFilename("felelos", safeName),
        showPageNumbers: true,
      }),
    })

    if (!response.ok) throw new Error(await response.text())
    const blob = await response.blob()
    const url = URL.createObjectURL(blob)
    const link = document.createElement("a")
    link.href = url
    link.download = createFieldPdfFilename("felelos", safeName)
    document.body.appendChild(link)
    link.click()
    link.remove()
    window.setTimeout(() => URL.revokeObjectURL(url), 30000)
  }

  async function exportSingleResponsiblePdf(responsibleKey: string) {
    const group = responsibleGroups.find((item) => item.responsible === responsibleKey)
    if (!group) return
    setIsExporting(true)
    setSaveMessage(`Felelős PDF készül: ${group.responsible}`)
    try {
      await exportResponsiblePdfForGroup(group)
      setSaveMessage(`Felelős PDF letöltve: ${group.responsible}`)
    } catch (error) {
      console.error(error)
      const message = error instanceof Error ? error.message : "Felelős PDF export hiba"
      setSaveMessage(message.slice(0, 120))
      window.alert(`PDF export hiba: ${message}`)
    } finally {
      setIsExporting(false)
    }
  }

  async function exportResponsiblePdfs() {
    if (responsibleGroups.length <= 1) {
      await exportFieldPdf()
      return
    }

    setIsExporting(true)
    setSaveMessage(`Vállalkozónkénti export készül: ${responsibleGroups.length} PDF`)
    try {
      for (const group of responsibleGroups) {
        await exportResponsiblePdfForGroup(group)
        await new Promise((resolve) => window.setTimeout(resolve, 500))
      }
      setSaveMessage(`${responsibleGroups.length} külön PDF exportálva vállalkozónként`)
    } catch (error) {
      console.error(error)
      const message = error instanceof Error ? error.message : "Vállalkozónkénti PDF export hiba"
      setSaveMessage(message.slice(0, 120))
      window.alert(`PDF export hiba: ${message}`)
    } finally {
      setIsExporting(false)
    }
  }

