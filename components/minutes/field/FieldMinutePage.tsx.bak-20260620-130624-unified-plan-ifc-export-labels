            ${planMarkerRows
              ? `<h4>HJ és FHJ jelölések a tervrészlet mellékletben</h4><div class="list-box">${planMarkerRows}</div>${buildHexPinLegend()}`
              : `<div class="no-photo compact">Tervi HJ / FHJ jelölés nem került rögzítésre.</div>`}
            ${issuePhotos.length
              ? `<h4>Kapcsolódó fotók a nagyított fotómellékletben</h4><div class="list-box">${issuePhotos
                  .map((photo) => `<div class="list-row"><strong>${escapeHtml(photo.serial)}</strong><span>${photo.dataUrl ? "Nagyított fotómellékletben szerepel" : "Kép nincs feltöltve"} · ${escapeHtml(photo.note || photo.name || "Fotómelléklet")}</span></div>`)
                  .join("")}</div>`
              : `<div class="no-photo compact">Fotó nem került rögzítésre.</div>`}
