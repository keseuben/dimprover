        setPlanLinks((current) => current.map((item) => {
          if (item.id !== link.id || item.finalized || item.scaleLocked) return item
          const nextZoom = Math.max(0.6, Math.min(2.5, Number((item.previewZoom + (event.deltaY > 0 ? -0.08 : 0.08)).toFixed(2))))
          return { ...item, previewZoom: nextZoom, drawingScale: "szabad nagyítás" }
        }))
        setSaveMessage("PDF előnézet nagyítása frissítve")
      }
      element.addEventListener("wheel", onWheel, { passive: false })
      return () => element.removeEventListener("wheel", onWheel)
    })
    return () => cleanups.forEach((cleanup) => cleanup?.())
  }, [activeIssuePlanLinks])
  const pendingDeleteIssue = useMemo(
    () => issues.find((issue) => issue.id === pendingDeleteIssueId) ?? null,
    [issues, pendingDeleteIssueId],
