  async function exportIssuesPdf(selectedIssues: FieldIssue[], exportNote: string, filename: string, selectedSignatureKeys?: string[]) {
    setIsExporting(true)
    setSaveMessage("PDF export készül")
    try {
      const response = await fetch("/api/minutes/pdf-export", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          html: buildFieldPdfHtmlForIssues(selectedIssues, exportNote, selectedSignatureKeys),
          title: "Terepi hibafelvételi jegyzőkönyv",
          filename,
          showPageNumbers: true,
        }),
      })
      if (!response.ok) throw new Error(await response.text())
      const blob = await response.blob()
      if (!blob.size) throw new Error("Üres PDF válasz érkezett")
      const url = URL.createObjectURL(blob)
      const link = document.createElement("a")
      link.href = url
      link.download = filename
      link.rel = "noopener"
      document.body.appendChild(link)
      link.click()
      link.remove()
      window.setTimeout(() => URL.revokeObjectURL(url), 30000)
      setSaveMessage("PDF export elkészült · letöltés indítva")
    } catch (error) {
      console.error(error)
      const message = error instanceof Error ? error.message : "PDF export hiba"
      setSaveMessage(message.slice(0, 120))
      window.alert(`PDF export hiba: ${message}`)
    } finally {
      setIsExporting(false)
    }
  }

