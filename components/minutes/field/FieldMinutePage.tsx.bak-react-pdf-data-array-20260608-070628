  async function renderPdfToCanvas(link: IssuePlanLink) {
    const canvas = planCanvasRefs.current[link.id]
    const pdfjsLib = typeof window !== "undefined" ? (window as any).pdfjsLib : null
    if (!canvas || !pdfjsLib || !link.planPreviewUrl) return
    try {
      const pdf = await pdfjsLib.getDocument(link.planPreviewUrl).promise
      const page = await pdf.getPage(Math.max(1, link.pageNumber || 1))
      const baseViewport = page.getViewport({ scale: 1, rotation: link.previewRotation || 0 })
      const targetWidth = 1120 * Math.max(0.5, link.previewZoom)
      const scale = targetWidth / baseViewport.width
      const viewport = page.getViewport({ scale, rotation: link.previewRotation || 0 })
      const pixelRatio = window.devicePixelRatio || 1
      canvas.width = Math.round(viewport.width * pixelRatio)
      canvas.height = Math.round(viewport.height * pixelRatio)
      canvas.style.width = `${Math.round(viewport.width)}px`
      canvas.style.height = `${Math.round(viewport.height)}px`
      const context = canvas.getContext("2d")
      if (!context) return
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0)
      context.clearRect(0, 0, viewport.width, viewport.height)
      await page.render({ canvasContext: context, viewport }).promise
    } catch (error) {
      console.error("DIMPROVER PDF.js render failed", error)
    }
  }

  useEffect(() => {
    if (!pdfJsReady) return
    activeIssuePlanLinks.forEach((link) => {
