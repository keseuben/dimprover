  function getPlanPaperSizeMm(sheetSize: PlanSheetSize, orientation: PlanOrientation) {
    const base = sheetSize === "A3" ? { shortSide: 297, longSide: 420 } : { shortSide: 210, longSide: 297 }
    return orientation === "landscape"
      ? { widthMm: base.longSide, heightMm: base.shortSide }
      : { widthMm: base.shortSide, heightMm: base.longSide }
  }

  function getPlanSelectionPreset(
    sheetSize: PlanSheetSize,
    orientation: PlanOrientation,
    sourceSheetSize: PlanSheetSize = "A3",
    sourceOrientation: PlanOrientation = "landscape",
  ) {
    const paper = getPlanPaperSizeMm(sheetSize, orientation)
    const sourcePaper = getPlanPaperSizeMm(sourceSheetSize, sourceOrientation)
    const width = (paper.widthMm / sourcePaper.widthMm) * 100
    const height = (paper.heightMm / sourcePaper.heightMm) * 100
    return { width: Math.round(clampPlanPercent(width, 4, 100)), height: Math.round(clampPlanPercent(height, 4, 100)) }
  }

