                <select value={emailPdfType} onChange={(event) => setEmailPdfType(event.target.value as EmailPdfType)} className="h-12 w-full border border-slate-200 bg-white px-3 text-sm font-black text-slate-800 outline-none focus:border-emerald-500">
                  <option value="full">Teljes hibajegyzék</option>
                  <option value="active-contractor">Aktív vállalkozó hibái · {activeContractorLabel}</option>
                  <option value="contractor-pack">Vállalkozónként külön PDF</option>
                </select>
              </label>
              <label className="block">
                <span className="mb-1 block text-[11px] font-black uppercase tracking-[0.12em] text-slate-500">Címzett</span>
                <input value={emailRecipient} onChange={(event) => setEmailRecipient(event.target.value)} placeholder="Pl.: Generálkivitelező Kft. / Kovács Gáspár" className="h-12 w-full border border-slate-200 bg-white px-3 text-sm font-semibold text-slate-800 outline-none placeholder:text-slate-400 focus:border-emerald-500" />
              </label>
              <label className="block">
                <span className="mb-1 block text-[11px] font-black uppercase tracking-[0.12em] text-slate-500">Tárgy</span>
                <input value={emailSubject} readOnly className="h-12 w-full border border-slate-200 bg-slate-50 px-3 text-sm font-semibold text-slate-700 outline-none" />
              </label>
              <label className="block">
                <span className="mb-1 block text-[11px] font-black uppercase tracking-[0.12em] text-slate-500">Üzenet</span>
                <textarea value={emailMessage} readOnly className="min-h-44 w-full border border-slate-200 bg-slate-50 px-3 py-3 text-sm font-semibold leading-6 text-slate-700 outline-none" />
              </label>
              <div className="grid gap-2 border-t border-slate-100 pt-3 sm:grid-cols-2">
                <button type="button" onClick={downloadPreparedEmailPdf} disabled={isExporting} className="border border-emerald-600 bg-emerald-600 px-4 py-3 text-sm font-black uppercase tracking-[0.08em] text-white hover:bg-emerald-700 disabled:opacity-60">{isExporting ? "PDF készül..." : "PDF letöltése"}</button>
                <button type="button" onClick={copyEmailText} className="border border-cyan-200 bg-cyan-50 px-4 py-3 text-sm font-black uppercase tracking-[0.08em] text-cyan-800 hover:bg-cyan-100">Email szöveg másolása</button>
              </div>
              <div className="border border-dashed border-slate-300 bg-slate-50 p-3 text-xs font-semibold leading-5 text-slate-500">
                Későbbi adatbázis és partnertörzs esetén ebből a felületből készülhet automatikus címzettválasztás, küldési napló és valódi email küldés.
              </div>
            </div>
          </div>
        </div>
      )}

      {editingPhoto && <PhotoMarkupEditor photo={editingPhoto} onSave={(dataUrl) => updatePhotoData(editingPhoto.id, dataUrl)} onCancel={() => setEditingPhotoId(null)} />}

      <div className="fixed left-3 right-3 top-3 z-[90] border border-emerald-200 bg-white/95 px-4 py-2 text-xs font-black uppercase tracking-[0.08em] text-emerald-700 shadow-sm md:hidden">
        {saveMessage}
      </div>
    </div>
  )
}
