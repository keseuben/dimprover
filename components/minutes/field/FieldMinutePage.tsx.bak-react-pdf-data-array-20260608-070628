  function fileToDataUrl(file: File) {
    return new Promise<string>((resolve, reject) => {
      const reader = new FileReader()
      reader.onload = () => resolve(String(reader.result || ""))
      reader.onerror = () => reject(reader.error)
      reader.readAsDataURL(file)
    })
  }

  async function optimizeImageDataUrl(dataUrl: string, maxSize = 1100, quality = 0.68) {
    return new Promise<{ dataUrl: string; width: number; height: number; compressedSize: number }>((resolve) => {
      const image = new Image()
      image.onload = () => {
        const scale = Math.min(1, maxSize / Math.max(image.width, image.height))
        const canvas = document.createElement("canvas")
        canvas.width = Math.max(1, Math.round(image.width * scale))
        canvas.height = Math.max(1, Math.round(image.height * scale))
        const context = canvas.getContext("2d")
        if (!context) {
          resolve({ dataUrl, width: image.width, height: image.height, compressedSize: Math.round((dataUrl.length * 3) / 4) })
          return
        }
        context.drawImage(image, 0, 0, canvas.width, canvas.height)
        const optimized = canvas.toDataURL("image/jpeg", quality)
        resolve({ dataUrl: optimized, width: canvas.width, height: canvas.height, compressedSize: Math.round((optimized.length * 3) / 4) })
      }
      image.onerror = () => resolve({ dataUrl, width: 0, height: 0, compressedSize: Math.round((dataUrl.length * 3) / 4) })
      image.src = dataUrl
    })
  }

  async function imageFileToPdfDataUrl(file: File) {
    const rawDataUrl = await fileToDataUrl(file)
    if (!file.type.startsWith("image/")) return { dataUrl: rawDataUrl, width: 0, height: 0, compressedSize: file.size }
    return optimizeImageDataUrl(rawDataUrl)
  }

