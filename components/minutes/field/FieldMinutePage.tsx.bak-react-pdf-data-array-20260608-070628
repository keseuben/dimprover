    )
    const exportWasPrepared = saveMessage.includes("PDF export elkészült") || saveMessage.includes("letöltés indítva")
    const exportReady = hasAnySignature || exportWasPrepared
    const attachmentState: WorkflowStepState = pdfAttachments.length ? "done" : "optional"
    const planState: WorkflowStepState = activeIssuePlanLinks.length ? "done" : "optional"

    const steps: { id: FieldStepId; label: string; state: WorkflowStepState; helper: string }[] = [
      { id: "issues", label: "Hibák listája", state: hasIssueList ? "done" : "pending", helper: hasIssueList ? `${issues.length} hiba rögzítve` : "Még nincs rögzített hiba" },
      { id: "form", label: "Hiba adatlap", state: activeIssueReady ? "done" : hasIssueList ? "partial" : "pending", helper: activeIssueReady ? "Aktív hiba alapadatai kitöltve" : "Megnevezés, helyszín, vállalkozó és határidő szükséges" },
      { id: "photos", label: "Fotók / tervfotók", state: hasActivePhoto ? "done" : hasAnyPhoto ? "partial" : "pending", helper: hasActivePhoto ? `${activeIssuePhotos.length} fotó az aktív hibán` : hasAnyPhoto ? `${photos.length} fotó más hibákhoz` : "Nincs kapcsolódó fotó" },
      { id: "plans", label: "Tervjelölés", state: planState, helper: activeIssuePlanLinks.length ? `${activeIssuePlanLinks.length} tervkapcsolat az aktív hibán` : "Opcionális: terv nélkül is rögzíthető" },
      { id: "attachments", label: "Mellékletek", state: attachmentState, helper: pdfAttachments.length ? `${pdfAttachments.length} PDF melléklet` : "Opcionális lépés" },
      { id: "export", label: "Aláírás / export", state: exportReady ? "done" : hasIssueList ? "partial" : "pending", helper: exportReady ? "Aláírás vagy sikeres export előkészítve" : "Aláírás vagy PDF export még hiányzik" },
    ]

    const score = [
      hasIssueList ? 1 : 0,
      activeIssueReady ? 1 : hasIssueList ? 0.45 : 0,
      hasActivePhoto ? 1 : hasAnyPhoto ? 0.55 : 0,
      exportReady ? 1 : hasIssueList ? 0.35 : 0,
    ].reduce((sum, value) => sum + value, 0)
    const attachmentBonus = pdfAttachments.length ? 0.2 : 0
    const progressPercent = Math.min(100, Math.round(((score + attachmentBonus) / 4) * 100))

    return { steps, progressPercent }
  }, [activeIssue, activeIssuePhotos.length, activeIssuePlanLinks.length, contractorSigners, issues.length, pdfAttachments.length, photos.length, saveMessage, signers.inspectorSignature])

