              <div className="flex items-center justify-between gap-2">
                <div className="font-black uppercase tracking-[0.1em] text-cyan-200">Kijelölt IFC elem</div>
                <button type="button" onClick={() => setSelectedIfcElement(null)} className="border border-white/10 bg-white/5 px-2 py-1 text-[9px] font-black uppercase text-slate-300">Töröl</button>
              </div>
              <div className="mt-2 grid gap-1">
                <div>Express ID: <span className="text-white">{selectedIfcElement.reference.expressId ?? "nincs találat"}</span></div>
                <div>GlobalId: <span className="text-white">{selectedIfcElement.reference.globalId || "nincs"}</span></div>
                <div>Elemnév: <span className="text-white">{selectedIfcElement.reference.elementName || "nincs elemadat"}</span></div>
                <div>Típus: <span className="text-white">{selectedIfcElement.reference.entityType || "nincs"}</span></div>
                <div>Szint: <span className="text-white">{selectedIfcElement.reference.levelName || "nincs"}</span></div>
                <div>API: <span className="text-white">{selectedIfcElement.reference.propertySource || "nincs"}</span></div>
                <div>Képernyőpont: <span className="text-white">X {selectedIfcElement.xPercent.toFixed(1)}% · Y {selectedIfcElement.yPercent.toFixed(1)}%</span></div>
                <div>3D pont: <span className="text-white">{selectedIfcElement.reference.worldPosition ? `${selectedIfcElement.reference.worldPosition.x}, ${selectedIfcElement.reference.worldPosition.y}, ${selectedIfcElement.reference.worldPosition.z}` : "nincs"}</span></div>
              </div>
              <button type="button" onClick={() => {
                if (!selectedIfcElement) return
                updateSelectedMarker({ ifcReference: selectedIfcElement.reference })
              }} disabled={!selectedMarker} className="mt-2 w-full border border-cyan-300/30 bg-cyan-400/10 px-2 py-2 text-[10px] font-black uppercase text-cyan-100 disabled:opacity-40">Kapcsolás kijelölt HJ-hez</button>
            </div>
          ) : null}
          {measurePoints.length ? (
            <div className="mt-3 border border-amber-300/45 bg-amber-400/10 p-2 text-[10px] font-bold text-amber-100">
              <div className="font-black uppercase tracking-[0.1em]">Mérési előnézet</div>
              <div className="mt-1">Pontok: {measurePoints.length}/2</div>
              <div>Távolság: {measureDistancePx !== null ? `${Math.round(measureDistancePx)} px` : "második pont szükséges"}</div>
              <button type="button" onClick={() => { setMeasurePoints([]); setMeasureMessage("Mérés törölve. Kattints két új pontra.") }} className="mt-2 w-full border border-amber-300/30 bg-slate-950/50 px-2 py-1.5 text-[10px] font-black uppercase text-amber-100">Mérés törlése</button>
            </div>
          ) : null}
          {selectedMarker ? (
            <div className="mt-3 max-h-[52vh] overflow-y-auto border border-emerald-300/45 bg-slate-950/80 p-2 pr-1 shadow-inner">
              <div className="flex items-center justify-between gap-2">
                <div>
                  <div className="text-xs font-black text-white">{selectedMarker.serial}</div>
                  <div className="mt-0.5 text-[10px] font-bold text-slate-400">{selectedMarker.markerKind === "photo" ? "FHJ fotóhely" : "HJ hibahely"} · X {selectedMarker.xPercent.toFixed(1)}% · Y {selectedMarker.yPercent.toFixed(1)}%</div>
                </div>
              </div>

              {selectedMarker.markerKind === "photo" ? (
                <div className="mt-2 border border-blue-300/20 bg-blue-400/10 px-2 py-2 text-[11px] font-bold leading-4 text-blue-100">
                  FHJ fotóhely marker. Fotó: {selectedMarker.photoSerial || selectedMarker.photoName || "nincs kiválasztott fotó"}
                </div>
              ) : null}

              <label className="mt-2 block text-[10px] font-black uppercase tracking-[0.08em] text-slate-400">
                Kapcsolt TH / hiba
                <select
                  value={selectedMarker.issueId || activeIssueId || file.issueId || ""}
                  onChange={(event) => changeSelectedMarkerIssue(event.target.value)}
                  className="mt-1 h-9 w-full border border-white/10 bg-slate-950 px-2 text-xs font-black text-white outline-none focus:border-emerald-400"
                >
                  {(file.issues?.length ? file.issues : [{ id: file.issueId || "active-issue", serial: file.issueSerial || "TH", title: file.issueTitle || "Tervi hibahely" }]).map((issue) => (
                    <option key={issue.id} value={issue.id}>{issue.serial} · {issue.title}</option>
                  ))}
                </select>
              </label>

              <label className="mt-2 block text-[10px] font-black uppercase tracking-[0.08em] text-slate-400">
                Szakág
                <select
                  value={selectedMarker.discipline}
                  onChange={(event) => updateSelectedMarker({ discipline: event.target.value as PlanIssueDiscipline })}
                  className="mt-1 h-9 w-full border border-white/10 bg-slate-950 px-2 text-xs font-black text-white outline-none focus:border-emerald-400"
                >
                  {planIssueDisciplines.map((item) => <option key={item.value} value={item.value}>{item.label}</option>)}
                </select>
              </label>

              <label className="mt-2 block text-[10px] font-black uppercase tracking-[0.08em] text-slate-400">
                Hiba megnevezése
                <input
                  value={selectedMarker.title || ""}
                  onChange={(event) => updateSelectedMarker({ title: event.target.value })}
                  className="mt-1 h-9 w-full border border-white/10 bg-slate-950 px-2 text-xs font-bold text-white outline-none focus:border-emerald-400"
                  placeholder="Pl.: Sérült burkolat / hiányzó rögzítés"
                />
              </label>

              <label className="mt-2 block text-[10px] font-black uppercase tracking-[0.08em] text-slate-400">
                Helyszín
                <input
                  value={selectedMarker.issueLocation || ""}
                  onChange={(event) => updateSelectedMarker({ issueLocation: event.target.value })}
                  className="mt-1 h-9 w-full border border-white/10 bg-slate-950 px-2 text-xs font-bold text-white outline-none focus:border-emerald-400"
                  placeholder="Pl.: földszint / északi oldal / 3. tengely"
                />
              </label>

              <div className="mt-2 grid grid-cols-2 gap-2">
                <label className="block text-[10px] font-black uppercase tracking-[0.08em] text-slate-400">
                  Súlyosság
                  <select
                    value={selectedMarker.issueSeverity || "Észrevétel"}
                    onChange={(event) => updateSelectedMarker({ issueSeverity: event.target.value })}
                    className="mt-1 h-9 w-full border border-white/10 bg-slate-950 px-2 text-[11px] font-black text-white outline-none focus:border-emerald-400"
                  >
                    {planMarkerSeverityOptions.map((severity) => <option key={severity} value={severity}>{severity}</option>)}
                  </select>
                </label>
                <label className="block text-[10px] font-black uppercase tracking-[0.08em] text-slate-400">
                  Státusz
                  <select
                    value={selectedMarker.status || "Nyitott"}
                    onChange={(event) => updateSelectedMarker({ status: event.target.value, issueStatus: event.target.value })}
                    className="mt-1 h-9 w-full border border-white/10 bg-slate-950 px-2 text-[11px] font-black text-white outline-none focus:border-emerald-400"
                  >
                    <option value="Nyitott">Nyitott</option>
                    <option value="Folyamatban">Folyamatban</option>
                    <option value="Ellenőrzésre vár">Ellenőrzésre vár</option>
                    <option value="Lezárt">Lezárt</option>
                  </select>
                </label>
              </div>

              <div className="mt-2 grid grid-cols-2 gap-2">
                <label className="block text-[10px] font-black uppercase tracking-[0.08em] text-slate-400">
                  Felelős / kapcsolattartó
                  <input
                    value={selectedMarker.responsible || ""}
                    onChange={(event) => updateSelectedMarker({ responsible: event.target.value, issueResponsible: event.target.value })}
                    className="mt-1 h-9 w-full border border-white/10 bg-slate-950 px-2 text-xs font-bold text-white outline-none focus:border-emerald-400"
                    placeholder="Pl.: alvállalkozó / művezető"
                  />
                </label>
                <label className="block text-[10px] font-black uppercase tracking-[0.08em] text-slate-400">
                  Határidő
                  <input
                    type="date"
                    value={selectedMarker.dueDate || ""}
                    onChange={(event) => updateSelectedMarker({ dueDate: event.target.value, issueDeadline: event.target.value })}
                    className="mt-1 h-9 w-full border border-white/10 bg-slate-950 px-2 text-xs font-black text-white outline-none focus:border-emerald-400"
                  />
                </label>
              </div>

              <div className="mt-2 flex flex-wrap gap-1">
                <button type="button" onClick={() => setDueDateOffset(3)} className="border border-emerald-300/30 bg-emerald-400/10 px-2 py-1 text-[10px] font-black uppercase text-emerald-100">+3 nap</button>
                <button type="button" onClick={() => setDueDateOffset(7)} className="border border-emerald-300/30 bg-emerald-400/10 px-2 py-1 text-[10px] font-black uppercase text-emerald-100">+7 nap</button>
                <button type="button" onClick={setDueDateToday} className="border border-white/10 bg-white/5 px-2 py-1 text-[10px] font-black uppercase text-slate-200">Mai nap</button>
              </div>

              <label className="mt-2 block text-[10px] font-black uppercase tracking-[0.08em] text-slate-400">
                Érintett vállalkozó
                <input
                  value={selectedMarker.issueContractorRepresentative || ""}
                  onChange={(event) => updateSelectedMarker({ issueContractorRepresentative: event.target.value })}
                  className="mt-1 h-9 w-full border border-white/10 bg-slate-950 px-2 text-xs font-bold text-white outline-none focus:border-emerald-400"
                  placeholder="Pl.: Generálkivitelező Kft."
                />
              </label>

              <label className="mt-2 block text-[10px] font-black uppercase tracking-[0.08em] text-slate-400">
                Leírás / megjegyzés
                <textarea
                  value={selectedMarker.note || selectedMarker.issueDescription || ""}
                  onChange={(event) => updateSelectedMarker({ note: event.target.value, issueDescription: event.target.value })}
                  className="mt-1 h-20 w-full resize-none border border-white/10 bg-slate-950 px-2 py-2 text-xs font-semibold text-white outline-none focus:border-emerald-400"
                  placeholder="Részletes hiba leírása, intézkedési javaslat, megjegyzés"
                />
              </label>

              <div className="mt-2 grid gap-1 border border-cyan-300/25 bg-cyan-950/45 p-2 text-[10px] font-bold text-slate-200">
                <div className="font-black uppercase tracking-[0.08em] text-emerald-300">IFC kapcsolat</div>
                <div>Express ID: <span className="text-white">{selectedMarker.ifcReference?.expressId ?? "nincs találat"}</span></div>
                <div>GlobalId: <span className="text-white">{selectedMarker.ifcReference?.globalId || "nincs"}</span></div>
                <div>Elem: <span className="text-white">{selectedMarker.ifcReference?.elementName || selectedMarker.ifcReference?.entityType || "nincs elemadat"}</span></div>
                <div>Szint: <span className="text-white">{selectedMarker.ifcReference?.levelName || "nincs"}</span></div>
                <div>Property API: <span className="text-white">{selectedMarker.ifcReference?.propertySource || "nincs"}</span></div>
                <div>Adat olvasva: <span className="text-white">{selectedMarker.ifcReference?.propertiesLoadedAt ? "igen" : "nem"}</span></div>
                <div>3D pont: <span className="text-white">{selectedMarker.ifcReference?.worldPosition ? `${selectedMarker.ifcReference.worldPosition.x}, ${selectedMarker.ifcReference.worldPosition.y}, ${selectedMarker.ifcReference.worldPosition.z}` : "nincs"}</span></div>
                <div>Kamera: <span className="text-white">{selectedMarker.ifcReference?.cameraSnapshot ? "mentve" : "nincs"}</span></div>
              </div>
              <button type="button" onClick={saveSelectedMarkerIfcSnapshot} disabled={engineStatus !== "ready"} className="mt-2 w-full border border-cyan-300/40 bg-cyan-400/10 px-2 py-2 text-[10px] font-black uppercase text-cyan-100 hover:bg-cyan-400/20 disabled:opacity-40">Kijelölt IFC nézetkép mentése</button>
              <button
                type="button"
                onPointerDown={(event) => {
                  event.preventDefault()
                  event.stopPropagation()
                }}
                onClick={(event) => {
                  event.preventDefault()
                  event.stopPropagation()
                  deleteSelectedMarker()
                }}
                className="mt-2 w-full border border-red-300/30 bg-red-500/10 px-2 py-2 text-[10px] font-black uppercase text-red-100 hover:bg-red-500/20"
              >
                Kijelölt marker törlése
              </button>
            </div>
          ) : (
            <div className="mt-3 border border-white/10 bg-white/5 px-3 py-2 text-xs font-bold text-slate-300">Nincs kijelölt marker.</div>
          )}
        </div>
      </div>
    </div>
  )
}
