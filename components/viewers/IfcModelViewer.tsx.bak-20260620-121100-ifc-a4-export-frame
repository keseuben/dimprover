function isLooseRecord(value: unknown): value is LooseIfcRecord {
  return typeof value === "object" && value !== null
}

function asVectorPosition(vector?: Vector3 | null): IfcMarkerWorldPosition | undefined {
  if (!vector) return undefined
  return {
    x: Number(vector.x.toFixed(4)),
    y: Number(vector.y.toFixed(4)),
    z: Number(vector.z.toFixed(4)),
  }
}

function readUnknownRecordValue(record: LooseIfcRecord | undefined, keys: string[]) {
  if (!record) return undefined
  for (const key of keys) {
    const value = record[key]
    if (value !== undefined && value !== null && value !== "") return value
  }
  return undefined
}

function readNumberRecordValue(record: LooseIfcRecord | undefined, keys: string[]) {
  const value = readUnknownRecordValue(record, keys)
  if (typeof value === "number" && Number.isFinite(value)) return value
  if (typeof value === "string") {
    const parsed = Number(value)
    if (Number.isFinite(parsed)) return parsed
  }
  return undefined
}

function readStringRecordValue(record: LooseIfcRecord | undefined, keys: string[]) {
  const value = readUnknownRecordValue(record, keys)
  if (typeof value === "string") return value
  if (typeof value === "number") return String(value)
  return undefined
}

function formatIfcLoadError(error: unknown) {
  if (error instanceof Error) {
    const message = error.message || error.name
    return message || "Ismeretlen IFC betöltési hiba."
  }
  if (typeof error === "string" && error.trim()) return error
  try {
    const serialized = JSON.stringify(error)
    return serialized && serialized !== "{}" ? serialized : "Ismeretlen IFC betöltési hiba."
  } catch {
    return "Ismeretlen IFC betöltési hiba."
  }
}

function formatIfcFileSize(bytes: number) {
  if (!Number.isFinite(bytes) || bytes <= 0) return "ismeretlen méret"
  return `${(bytes / 1024 / 1024).toFixed(1)} MB`
}

function clampIfcLoadingProgress(value: number) {
  return Math.min(99, Math.max(1, Math.round(value)))
}

function getIfcLoadingStageLabel(stage: IfcLoadingStage) {
  if (stage === "engine") return "IFC motor"
  if (stage === "download") return "Fájl letöltés"
  if (stage === "wasm") return "WASM inicializálás"
  if (stage === "convert") return "Fragments konverzió"
  if (stage === "camera") return "Kamera igazítás"
  return "Kész"
}

async function readIfcResponseBuffer(
  response: Response,
  onProgress: (progress: number, detail: string, fileSizeLabel?: string) => void,
) {
  const totalBytes = Number(response.headers.get("content-length") || 0)
  const fileSizeLabel = totalBytes > 0 ? formatIfcFileSize(totalBytes) : undefined
  if (!response.body) {
    const fallbackBuffer = new Uint8Array(await response.arrayBuffer())
    onProgress(70, `IFC fájl letöltve: ${formatIfcFileSize(fallbackBuffer.byteLength)}`, formatIfcFileSize(fallbackBuffer.byteLength))
    return fallbackBuffer
  }

  const reader = response.body.getReader()
  const chunks: Uint8Array[] = []
  let receivedBytes = 0

  while (true) {
    const { done, value } = await reader.read()
    if (done) break
    if (!value) continue
    chunks.push(value)
    receivedBytes += value.byteLength
    if (totalBytes > 0) {
      const downloadProgress = 28 + (receivedBytes / totalBytes) * 42
      onProgress(downloadProgress, `${formatIfcFileSize(receivedBytes)} / ${fileSizeLabel}`, fileSizeLabel)
    } else {
      onProgress(Math.min(68, 34 + chunks.length * 2), `${formatIfcFileSize(receivedBytes)} letöltve`, formatIfcFileSize(receivedBytes))
    }
  }

  const buffer = new Uint8Array(receivedBytes)
  let offset = 0
  for (const chunk of chunks) {
    buffer.set(chunk, offset)
    offset += chunk.byteLength
  }
  onProgress(72, `IFC fájl letöltve: ${formatIfcFileSize(buffer.byteLength)}`, formatIfcFileSize(buffer.byteLength))
  return buffer
}

function isThreeObject3D(value: unknown): value is Object3D {
  return isLooseRecord(value) && typeof value.updateWorldMatrix === "function" && typeof value.traverse === "function"
}

function getObjectBoundingBox(object: Object3D) {
  if (!isThreeObject3D(object)) return null
  const box = new Box3().setFromObject(object)
  const size = new Vector3()
  const center = new Vector3()
  box.getSize(size)
  box.getCenter(center)
  const maxDimension = Math.max(size.x, size.y, size.z)
  if (!Number.isFinite(maxDimension) || maxDimension <= 0) return null
  return { box, size, center, maxDimension }
}

function formatIfcModelSize(size: Vector3) {
  return `${size.x.toFixed(1)} × ${size.y.toFixed(1)} × ${size.z.toFixed(1)}`
}

function getRecordCallable(record: LooseIfcRecord | undefined, key: string): RuntimeFunction | null {
  const candidate = record?.[key]
  return typeof candidate === "function" ? candidate as RuntimeFunction : null
}

function getDomCanvas(container: HTMLDivElement | null): HTMLCanvasElement | null {
  return container?.querySelector("canvas") ?? null
}

function normalizeFragmentsRaycastResult(result: unknown): {
  expressId?: number
  modelId?: string
  object?: Object3D
  point?: Vector3
  source?: string
} | null {
  if (!isLooseRecord(result)) return null
  const fragments = isLooseRecord(result.fragments) ? result.fragments : undefined
  const object = isThreeObject3D(result.object) ? result.object : undefined
  const point = result.point instanceof Vector3 ? result.point : undefined
  const expressId = typeof result.itemId === "number"
    ? result.itemId
    : typeof result.localId === "number"
      ? result.localId
      : undefined
  const modelIdValue = fragments?.modelId
  return {
    expressId,
    modelId: typeof modelIdValue === "string" ? modelIdValue : undefined,
    object,
    point,
    source: "fragmentsManager.raycast",
  }
}

function unwrapIfcPropertyValue(value: unknown): unknown {
  if (isLooseRecord(value)) {
    const lowerValue = value.value
    if (lowerValue !== undefined && lowerValue !== null) return lowerValue
    const upperValue = value.Value
    if (upperValue !== undefined && upperValue !== null) return upperValue
  }
  return value
}

function readIfcTextValue(record: LooseIfcRecord | undefined, keys: string[]) {
  if (!record) return undefined
  for (const key of keys) {
    const value = unwrapIfcPropertyValue(record[key])
    if (typeof value === "string" && value.trim()) return value
    if (typeof value === "number" && Number.isFinite(value)) return String(value)
  }
  return undefined
}

function readIfcNumberValue(record: LooseIfcRecord | undefined, keys: string[]) {
  if (!record) return undefined
  for (const key of keys) {
    const value = unwrapIfcPropertyValue(record[key])
    if (typeof value === "number" && Number.isFinite(value)) return value
    if (typeof value === "string") {
      const parsed = Number(value)
      if (Number.isFinite(parsed)) return parsed
    }
  }
  return undefined
}

function findNestedIfcTextValue(value: unknown, keys: string[], maxDepth = 4, visited = new Set<unknown>()): string | undefined {
  if (maxDepth < 0 || value === null || value === undefined) return undefined
  const unwrapped = unwrapIfcPropertyValue(value)
  if (typeof unwrapped === "string" || typeof unwrapped === "number") return undefined
  if (Array.isArray(unwrapped)) {
    for (const item of unwrapped) {
      const found = findNestedIfcTextValue(item, keys, maxDepth - 1, visited)
      if (found) return found
    }
    return undefined
  }
  if (!isLooseRecord(unwrapped) || visited.has(unwrapped)) return undefined
  visited.add(unwrapped)
  const direct = readIfcTextValue(unwrapped, keys)
  if (direct) return direct
  for (const nestedValue of Object.values(unwrapped)) {
    const found = findNestedIfcTextValue(nestedValue, keys, maxDepth - 1, visited)
    if (found) return found
  }
  return undefined
}

function findIfcStoreyName(value: unknown): string | undefined {
  const stack: unknown[] = [value]
  const visited = new Set<unknown>()
  while (stack.length) {
    const current = unwrapIfcPropertyValue(stack.pop())
    if (!current || visited.has(current)) continue
    if (Array.isArray(current)) {
      current.forEach((item) => stack.push(item))
      continue
    }
    if (!isLooseRecord(current)) continue
    visited.add(current)
    const text = Object.values(current)
      .map((item) => {
        const unwrapped = unwrapIfcPropertyValue(item)
        return typeof unwrapped === "string" ? unwrapped.toLowerCase() : ""
      })
      .join(" ")
    const recordKeys = Object.keys(current).join(" ").toLowerCase()
    const looksLikeStorey = recordKeys.includes("storey") || text.includes("ifcbuildingstorey") || text.includes("buildingstorey")
    if (looksLikeStorey) {
      const name = readIfcTextValue(current, ["Name", "name", "LongName", "longName", "levelName", "level"])
      if (name) return name
    }
    Object.values(current).forEach((item) => stack.push(item))
  }
  return undefined
}

function normalizeIfcPropertyPatch(source: string, payload: unknown): Partial<IfcMarkerElementReference> {
  const recordPayload = Array.isArray(payload) ? payload.find(isLooseRecord) : payload
  if (!isLooseRecord(recordPayload)) return {}
  const directRecord = recordPayload
  const elementName =
    readIfcTextValue(directRecord, ["Name", "name", "LongName", "longName", "ObjectType", "objectType"])
    ?? findNestedIfcTextValue(directRecord, ["Name", "name", "LongName", "longName", "ObjectType", "objectType"])
  const patch: Partial<IfcMarkerElementReference> = {
    expressId: readIfcNumberValue(directRecord, ["expressID", "expressId", "ExpressID", "id", "elementId"]),
    globalId:
      readIfcTextValue(directRecord, ["GlobalId", "globalId", "guid", "ifcGuid"])
      ?? findNestedIfcTextValue(directRecord, ["GlobalId", "globalId", "guid", "ifcGuid"]),
    entityType:
      readIfcTextValue(directRecord, ["type", "ifcType", "entityType", "PredefinedType", "predefinedType"])
      ?? findNestedIfcTextValue(directRecord, ["type", "ifcType", "entityType", "PredefinedType", "predefinedType"]),
    elementName,
    levelName:
      readIfcTextValue(directRecord, ["levelName", "level", "storey", "buildingStorey"])
      ?? findIfcStoreyName(directRecord),
    propertySource: source,
    propertiesLoadedAt: new Date().toISOString(),
  }
  return Object.fromEntries(Object.entries(patch).filter(([, value]) => value !== undefined && value !== "")) as Partial<IfcMarkerElementReference>
}

function mergeIfcElementReference(base: IfcMarkerElementReference, patch: Partial<IfcMarkerElementReference>): IfcMarkerElementReference {
  return {
    ...base,
    ...patch,
    expressId: patch.expressId ?? base.expressId,
    globalId: patch.globalId ?? base.globalId,
    entityType: patch.entityType ?? base.entityType,
    elementName: patch.elementName ?? base.elementName,
    levelName: patch.levelName ?? base.levelName,
    worldPosition: base.worldPosition,
    cameraSnapshot: base.cameraSnapshot,
    screenPosition: base.screenPosition,
  }
}

async function readIfcPropertiesFromModel(model: Object3D | LooseIfcRecord | undefined, expressId?: number): Promise<Partial<IfcMarkerElementReference>> {
  if (!model || expressId === undefined) return {}
  const modelRecord = model as unknown as LooseIfcRecord
  const attempts: Array<{ name: string; key: string; args: unknown[] }> = [
    { name: "model.getItemsData", key: "getItemsData", args: [[expressId]] },
    { name: "model.getItemProperties", key: "getItemProperties", args: [expressId] },
    { name: "model.getProperties", key: "getProperties", args: [expressId] },
    { name: "model.getPropertiesData", key: "getPropertiesData", args: [[expressId]] },
  ]
  for (const attempt of attempts) {
    const callable = getRecordCallable(modelRecord, attempt.key)
    if (!callable) continue
    try {
      const payload = await Promise.resolve(callable.call(modelRecord, ...attempt.args))
      const patch = normalizeIfcPropertyPatch(attempt.name, payload)
      if (patch.globalId || patch.elementName || patch.entityType || patch.levelName) return patch
    } catch (propertyError) {
      console.warn("IFC property read failed", attempt.name, propertyError)
    }
  }
  return {}
}

function buildMarkerIssuePatch(file: PlanViewerFile, issueId?: string) {
  const issue = file.issues?.find((item) => item.id === issueId)
  return {
    issueId: issue?.id ?? issueId ?? file.issueId,
    issueSerial: issue?.serial ?? file.issueSerial,
    issueTitle: issue?.title ?? file.issueTitle,
    issueLocation: issue?.location,
    issueDescription: issue?.description,
    issueSeverity: issue?.severity,
    issueResponsible: issue?.responsible,
    issueContractorRepresentative: issue?.contractorRepresentative,
    issueDeadline: issue?.deadline,
    issueStatus: issue?.status,
    issueNote: issue?.note,
  }
}

function getNextIfcMarkerSerial(markers: PlanIssueMarker[], issueId?: string) {
  const nextNumber = markers.filter((marker) => marker.issueId === issueId && marker.sourceType === "ifc" && marker.markerKind !== "photo").length + 1
  return `HJ-${String(nextNumber).padStart(3, "0")}`
}

function getNextIfcPhotoMarkerSerial(markers: PlanIssueMarker[], issueId?: string) {
  const nextNumber = markers.filter((marker) => marker.issueId === issueId && marker.sourceType === "ifc" && marker.markerKind === "photo").length + 1
  return `FHJ-${String(nextNumber).padStart(3, "0")}`
}

function formatDateInput(date: Date) {
  return date.toISOString().slice(0, 10)
}

function sanitizeIfcExportFileName(value: string) {
  return value.replace(/[^a-zA-Z0-9áéíóöőúüűÁÉÍÓÖŐÚÜŰ_.-]+/g, "_").replace(/_+/g, "_").slice(0, 90)
}

function downloadIfcDataUrl(dataUrl: string, fileName: string) {
  const link = document.createElement("a")
  link.href = dataUrl
  link.download = fileName
  document.body.appendChild(link)
  link.click()
  link.remove()
}

function drawIfcExportMarker(
  context: CanvasRenderingContext2D,
  marker: PlanIssueMarker,
  x: number,
  y: number,
  selected: boolean,
) {
  const isPhoto = marker.markerKind === "photo"
  const radius = isPhoto ? 18 : 16
  context.save()
  context.translate(x, y)
  context.shadowColor = "rgba(0,0,0,0.45)"
  context.shadowBlur = 12
  context.shadowOffsetY = 4

  context.beginPath()
  for (let index = 0; index < 6; index += 1) {
    const angle = Math.PI / 6 + index * Math.PI / 3
    const px = Math.cos(angle) * radius
    const py = Math.sin(angle) * radius
    if (index === 0) context.moveTo(px, py)
    else context.lineTo(px, py)
  }
  context.closePath()
  context.fillStyle = isPhoto ? "#2563eb" : "#34d399"
  context.fill()
  context.lineWidth = selected ? 4 : 2
  context.strokeStyle = selected ? "#67e8f9" : "#ffffff"
  context.stroke()

  context.beginPath()
  context.moveTo(-5, radius - 1)
  context.lineTo(0, radius + 22)
  context.lineTo(5, radius - 1)
  context.closePath()
  context.fillStyle = isPhoto ? "#1d4ed8" : "#10b981"
  context.fill()
  context.strokeStyle = "rgba(255,255,255,0.85)"
  context.lineWidth = 1
  context.stroke()

  context.shadowBlur = 0
  context.fillStyle = "#ffffff"
  context.font = "900 10px Arial"
  context.textAlign = "center"
  context.textBaseline = "middle"
  context.fillText(isPhoto ? "F" : "HJ", 0, 0)

  const serial = (marker.serial || "HJ").replace(/^IFC-/i, "")
  context.fillStyle = "rgba(255,255,255,0.96)"
  context.strokeStyle = "rgba(15,23,42,0.25)"
  context.lineWidth = 1
  const labelWidth = Math.max(54, serial.length * 7 + 16)
  context.fillRect(-labelWidth / 2, -radius - 22, labelWidth, 16)
  context.strokeRect(-labelWidth / 2, -radius - 22, labelWidth, 16)
  context.fillStyle = "#0f172a"
  context.font = "900 9px Arial"
  context.fillText(serial, 0, -radius - 14)
  context.restore()
}

function isIfcMarkerUiTarget(target: EventTarget | null) {
  return target instanceof HTMLElement && Boolean(target.closest('[data-ifc-marker-ui="true"], [data-plan-marker="true"]'))
}

export default function IfcModelViewer({ file }: IfcModelViewerProps) {
  const shellRef = useRef<HTMLDivElement | null>(null)
  const viewerRef = useRef<HTMLDivElement | null>(null)
  const markerLayerRef = useRef<HTMLDivElement | null>(null)
  const runtimeRef = useRef<IfcRuntime | null>(null)
  const placementPointerRef = useRef<{ pointerId: number; clientX: number; clientY: number; placedOnDown?: boolean } | null>(null)
  const lastPlacementRef = useRef<{ time: number; clientX: number; clientY: number } | null>(null)
  const markerDragRef = useRef<MarkerDragState | null>(null)
  const [viewMode, setViewMode] = useState<"orbit" | "select" | "section" | "measure" | "mark">("orbit")
  const [showGrid, setShowGrid] = useState(true)
  const [showLevels, setShowLevels] = useState(true)
  const [markers, setMarkers] = useState<PlanIssueMarker[]>(file.markers ?? [])
  const [selectedMarkerId, setSelectedMarkerId] = useState<string | null>(file.selectedMarkerId ?? file.markers?.[0]?.id ?? null)
  const [activeIssueId, setActiveIssueId] = useState(file.activeIssueId || file.issueId || file.issues?.[0]?.id || "")
  const [activeDiscipline, setActiveDiscipline] = useState<PlanIssueDiscipline>("architecture")
  const [markerPlacementMode, setMarkerPlacementMode] = useState<"issue" | "photo">("issue")
  const [selectedPhotoIdForMarker, setSelectedPhotoIdForMarker] = useState(file.photos?.[0]?.id || "")
  const [selectedIfcElement, setSelectedIfcElement] = useState<IfcSelectedElementState | null>(null)
  const [measurePoints, setMeasurePoints] = useState<IfcMeasurePoint[]>([])
  const [measureMessage, setMeasureMessage] = useState("")
  const [engineStatus, setEngineStatus] = useState<IfcEngineStatus>(file.url ? "idle" : "missing-source")
  const [loadingState, setLoadingState] = useState<IfcLoadingState>({
    progress: 1,
    stage: "engine",
    label: "IFC előkészítés",
    detail: "DIMPROVER modellnéző indul",
  })
  const [statusMessage, setStatusMessage] = useState(file.url ? "IFC forrás előkészítve" : "Nincs IFC URL megadva")
  const [placementMessage, setPlacementMessage] = useState("")
  const [exportMessage, setExportMessage] = useState("")
  const [engineErrorDetail, setEngineErrorDetail] = useState("")

  const selectedMarker = markers.find((marker) => marker.id === selectedMarkerId) ?? null
  const activeIssue = file.issues?.find((issue) => issue.id === activeIssueId)
  const activeIssuePhotosForMarker = (file.photos || []).filter((photo) => !activeIssueId || photo.issueId === activeIssueId)
  const selectedPhotoForMarker = activeIssuePhotosForMarker.find((photo) => photo.id === selectedPhotoIdForMarker) || activeIssuePhotosForMarker[0] || null
  const isIfcLoading = engineStatus === "loading-engine" || engineStatus === "loading-model"
  const hasInteractiveOverlay = viewMode === "mark" || viewMode === "select" || viewMode === "measure"
  const measureDistancePx = measurePoints.length >= 2 ? Math.hypot(measurePoints[1].clientX - measurePoints[0].clientX, measurePoints[1].clientY - measurePoints[0].clientY) : null

  function scrollIfcViewerIntoFocus() {
    const shell = shellRef.current
    if (!shell) return
    window.requestAnimationFrame(() => {
      shell.scrollIntoView({ behavior: "smooth", block: "start", inline: "nearest" })
    })
  }

  useEffect(() => {
    if (!isIfcLoading) return
    scrollIfcViewerIntoFocus()
    const timer = window.setTimeout(scrollIfcViewerIntoFocus, 250)
    return () => window.clearTimeout(timer)
  }, [isIfcLoading, file.id])

  useEffect(() => {
    const timer = window.setTimeout(() => {
      if (!activeIssuePhotosForMarker.length) {
        if (markerPlacementMode === "photo") setMarkerPlacementMode("issue")
        return
      }
      setSelectedPhotoIdForMarker((current) => current && activeIssuePhotosForMarker.some((photo) => photo.id === current) ? current : activeIssuePhotosForMarker[0]?.id || "")
    }, 0)
    return () => window.clearTimeout(timer)
  }, [activeIssuePhotosForMarker, markerPlacementMode])

  useEffect(() => {
    function handleKeyDown(event: KeyboardEvent) {
      if ((event.key !== "Delete" && event.key !== "Backspace") || !selectedMarkerId) return
      const target = event.target
      if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement) return
      event.preventDefault()
      const nextMarkers = markers.filter((marker) => marker.id !== selectedMarkerId)
      commitMarkers(nextMarkers)
      selectMarker(nextMarkers[0]?.id ?? null)
      setPlacementMessage("Kijelölt marker törölve.")
    }
    window.addEventListener("keydown", handleKeyDown)
    return () => window.removeEventListener("keydown", handleKeyDown)
  // commitMarkers and selectMarker are stable local handlers for this keyboard shortcut context.
  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [markers, selectedMarkerId])

  const engineLabel = useMemo(() => {
    if (engineStatus === "ready") return "IFC modell betöltve"
    if (engineStatus === "loading-engine") return "IFC motor betöltése..."
    if (engineStatus === "loading-model") return "IFC modell betöltése..."
    if (engineStatus === "fallback") return "IFC shell aktív, motor fallback állapotban"
    if (engineStatus === "missing-source") return "Nincs IFC URL megadva"
    return "IFC forrás előkészítve"
  }, [engineStatus])

  useEffect(() => {
    const timer = window.setTimeout(() => {
      setMarkers(file.markers ?? [])
      setSelectedMarkerId(file.selectedMarkerId ?? file.markers?.[0]?.id ?? null)
    }, 0)
    return () => window.clearTimeout(timer)
  }, [file.id, file.markers, file.selectedMarkerId])

  useEffect(() => {
    const timer = window.setTimeout(() => {
      setActiveIssueId(file.activeIssueId || file.issueId || file.issues?.[0]?.id || "")
    }, 0)
    return () => window.clearTimeout(timer)
  }, [file.id, file.activeIssueId, file.issueId, file.issues])

  useEffect(() => {
    let cancelled = false

    async function disposeRuntime() {
      const runtime = runtimeRef.current
      runtimeRef.current = null
      try {
        await runtime?.dispose?.()
      } catch (disposeError) {
        console.warn("IFC viewer dispose failed", disposeError)
      }
    }

    async function loadIfcViewer() {
      const container = viewerRef.current
      if (!container) return
      await disposeRuntime()
      container.innerHTML = ""

      if (!file.url) {
        setEngineStatus("missing-source")
        setStatusMessage("IFC megjelenítéshez szükséges egy elérhető .ifc fájl URL.")
        return
      }

      try {
        setEngineStatus("loading-engine")
        setLoadingState({ progress: 6, stage: "engine", label: "IFC motor indítása", detail: "DIMPROVER modellnéző előkészítése" })
        setStatusMessage("@thatopen/components + web-ifc motor betöltése...")

        // The IFC package exposes a dynamic runtime API; this local cast keeps the dependency isolated from the rest of DIMPROVER.
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const OBC = await import("@thatopen/components") as unknown as Record<string, any>
        setLoadingState({ progress: 12, stage: "engine", label: "IFC motor betöltve", detail: "Fragments modul előkészítése" })
        const FRAGS = await import("@thatopen/fragments")
        if (cancelled) return

        const components = new OBC.Components()
        const worlds = components.get(OBC.Worlds)
        const world = worlds.create()

        world.scene = new OBC.SimpleScene(components)
        world.renderer = new OBC.SimpleRenderer(components, container)
        world.camera = new OBC.SimpleCamera(components)

        await components.init?.()
        setLoadingState({ progress: 20, stage: "engine", label: "IFC világ létrehozva", detail: "Renderer, kamera és scene inicializálva" })

        const fragmentsManager = OBC.FragmentsManager ? components.get(OBC.FragmentsManager) : null
        if (fragmentsManager) {
          const fragmentsManagerRecord = isLooseRecord(fragmentsManager) ? fragmentsManager : undefined
          const initFragments = getRecordCallable(fragmentsManagerRecord, "init")
          const alreadyInitialized = fragmentsManagerRecord?.initialized === true
          if (initFragments && !alreadyInitialized) {
            let workerUrl: string | undefined
            try {
              workerUrl = typeof OBC.FragmentsManager?.getWorker === "function"
                ? await OBC.FragmentsManager.getWorker()
                : undefined
            } catch (workerError) {
              console.warn("Fragments worker URL resolve failed, using default init fallback", workerError)
            }
            if (workerUrl) initFragments.call(fragmentsManager, workerUrl)
            else initFragments.call(fragmentsManager)
          }
        }

        world.scene.setup?.()
        world.scene.three.background = null

        if (showGrid && OBC.Grids) {
          const grids = components.get(OBC.Grids)
          grids.create(world)
        }

        setEngineStatus("loading-model")
        setEngineErrorDetail("")
        setStatusMessage("IFC fájl letöltése, web-ifc WASM inicializálása és modell betöltése...")

        setLoadingState({ progress: 24, stage: "wasm", label: "WASM motor előkészítése", detail: "/wasm/web-ifc/ betöltési útvonal ellenőrzése" })
        const ifcLoader = components.get(OBC.IfcLoader)
        await ifcLoader.setup({
          autoSetWasm: false,
          wasm: {
            path: "/wasm/web-ifc/",
            absolute: true,
          },
          customLocateFileHandler: (requestedFileName: string) => {
            const normalizedFileName = requestedFileName.split("/").pop() || "web-ifc.wasm"
            return `/wasm/web-ifc/${normalizedFileName}`
          },
        })
        setLoadingState({ progress: 28, stage: "download", label: "IFC fájl letöltése", detail: "Nagy méretű modell beolvasása folyamatban" })
        const response = await fetch(file.url)
        if (!response.ok) throw new Error(`IFC fájl nem elérhető: ${response.status}`)
        const buffer = await readIfcResponseBuffer(response, (progress, detail, fileSizeLabel) => {
          setLoadingState({ progress: clampIfcLoadingProgress(progress), stage: "download", label: "IFC fájl letöltése", detail, fileSizeLabel })
        })
        setLoadingState({ progress: 76, stage: "convert", label: "IFC modell konvertálása", detail: `${formatIfcFileSize(buffer.byteLength)} · Fragments modell építése`, fileSizeLabel: formatIfcFileSize(buffer.byteLength) })
        setStatusMessage(`IFC fájl letöltve (${formatIfcFileSize(buffer.byteLength)}). Modell konvertálása Fragments formátumra...`)
        const model = await ifcLoader.load(buffer, true, file.name)
        if (cancelled) return

        const modelRecord = isLooseRecord(model) ? model : undefined
        const fragmentsCore = isLooseRecord(fragmentsManager) ? fragmentsManager.core : undefined
        const updateFragments = isLooseRecord(fragmentsCore) ? getRecordCallable(fragmentsCore, "update") : null
        const refreshFragments = async (force = true) => {
          if (updateFragments) await Promise.resolve(updateFragments.call(fragmentsCore, force))
        }

        const modelObject = modelRecord?.object
        const visibleModelObject = isThreeObject3D(modelObject) ? modelObject : isThreeObject3D(model) ? model : null
        const useCamera = getRecordCallable(modelRecord, "useCamera")
        if (useCamera && world.camera?.three) {
          useCamera.call(model, world.camera.three)
        }

        const setLodMode = getRecordCallable(modelRecord, "setLodMode")
        if (setLodMode && FRAGS.LodMode?.ALL_GEOMETRY !== undefined) {
          await Promise.resolve(setLodMode.call(model, FRAGS.LodMode.ALL_GEOMETRY))
        }

        if (visibleModelObject && !visibleModelObject.parent) {
          world.scene.three.add(visibleModelObject)
        }

        setLoadingState({ progress: 86, stage: "convert", label: "Geometria feldolgozása", detail: "Fragments render frissítés" })
        await refreshFragments(true)

        const controlsRecord = isLooseRecord(world.camera?.controls) ? world.camera.controls : undefined
        const addControlListener = getRecordCallable(controlsRecord, "addEventListener")
        const removeControlListener = getRecordCallable(controlsRecord, "removeEventListener")
        const handleCameraSettled = () => {
          void refreshFragments(true)
          // IFC marker MVP: keep overlay markers at the clicked screen position.
          // 3D worldPosition is stored as metadata only until stable element snapping is implemented.
        }
        if (addControlListener) {
          addControlListener.call(controlsRecord, "rest", handleCameraSettled)
          addControlListener.call(controlsRecord, "sleep", handleCameraSettled)
          addControlListener.call(controlsRecord, "controlend", handleCameraSettled)
        }

        const modelBounds = visibleModelObject ? getObjectBoundingBox(visibleModelObject) : null
        if (modelBounds) {
          const { center, size, maxDimension } = modelBounds
          const cameraDistance = Math.max(12, maxDimension * 1.65)
          await world.camera.controls?.setLookAt?.(
            center.x + cameraDistance,
            center.y + cameraDistance * 0.72,
            center.z + cameraDistance,
            center.x,
            center.y,
            center.z,
            true,
          )
          setLoadingState({ progress: 94, stage: "camera", label: "Kamera igazítása", detail: `Modellméret: ${formatIfcModelSize(size)}` })
          await refreshFragments(true)
          setStatusMessage(`IFC modell betöltve · modellméret: ${formatIfcModelSize(size)} · kamera a modellre igazítva.`)
        } else {
          await world.camera.controls?.setLookAt?.(12, 10, 12, 0, 0, 0, true)
          setLoadingState({ progress: 94, stage: "camera", label: "Kamera alapnézet", detail: "Befoglaló méret nem olvasható" })
          await refreshFragments(true)
          setStatusMessage("IFC modell betöltve, de a modell befoglaló mérete nem olvasható. Próbáld az Orbit nézetet / görgős zoomot.")
        }
        world.renderer.resize?.()
        await refreshFragments(true)
        // IFC marker MVP: keep overlay markers at the clicked screen position.

        runtimeRef.current = {
          world: world as LooseIfcRecord,
          model: visibleModelObject ?? (model as Object3D),
          rawModel: modelRecord,
          fragmentsManager: isLooseRecord(fragmentsManager) ? fragmentsManager : undefined,
          components: components as LooseIfcRecord,
          dispose: async () => {
            if (removeControlListener) {
              try { removeControlListener.call(controlsRecord, "rest", handleCameraSettled) } catch {}
              try { removeControlListener.call(controlsRecord, "sleep", handleCameraSettled) } catch {}
              try { removeControlListener.call(controlsRecord, "controlend", handleCameraSettled) } catch {}
            }
            try { world.renderer?.dispose?.() } catch {}
            try { components.dispose?.() } catch {}
          },
        }
        setLoadingState({ progress: 100, stage: "ready", label: "IFC modell betöltve", detail: "DIMPROVER modellnéző kész" })
        setEngineStatus("ready")
        if (!modelBounds) setStatusMessage("IFC modell betöltve. HJ jelölés módban a marker modellnézeti pontot, 3D találati pozíciót és kameraállást is ment.")
      } catch (error) {
        const errorMessage = formatIfcLoadError(error)
        console.error("DIMPROVER IFC model load failed", {
          fileName: file.name,
          fileType: file.type,
          error,
        })
        if (cancelled) return
        await disposeRuntime()
        setEngineStatus("fallback")
        setEngineErrorDetail(errorMessage)
        setStatusMessage(`IFC motor fallback: ${errorMessage}`)
      }
    }

    loadIfcViewer()

    return () => {
      cancelled = true
      void disposeRuntime()
    }
  }, [file.id, file.name, file.type, file.url, showGrid])

  function commitMarkers(nextMarkers: PlanIssueMarker[]) {
    setMarkers(nextMarkers)
    file.onMarkersChange?.(nextMarkers)
  }

  function selectMarker(markerId: string | null) {
    setSelectedMarkerId(markerId)
    file.onSelectedMarkerChange?.(markerId)
  }

  function getCameraSnapshot(): IfcMarkerCameraSnapshot | undefined {
    const world = runtimeRef.current?.world
    if (!world) return undefined
    const cameraWrapper = isLooseRecord(world.camera) ? world.camera : undefined
    const camera = cameraWrapper && isLooseRecord(cameraWrapper.three) ? cameraWrapper.three as unknown as Camera : undefined
    const controls = cameraWrapper && isLooseRecord(cameraWrapper.controls) ? cameraWrapper.controls : undefined
    const targetCandidate = controls && isLooseRecord(controls.target) ? controls.target as unknown as Vector3 : undefined
    if (!camera) return undefined
    return {
      position: asVectorPosition(camera.position) ?? { x: 0, y: 0, z: 0 },
      target: asVectorPosition(targetCandidate),
      zoom: "zoom" in camera && typeof camera.zoom === "number" ? camera.zoom : undefined,
    }
  }

  function getWorldCamera(): Camera | null {
    const world = runtimeRef.current?.world
    if (!world || !isLooseRecord(world.camera)) return null
    const cameraWrapper = world.camera
    if (!isLooseRecord(cameraWrapper.three)) return null
    return cameraWrapper.three as unknown as Camera
  }

  function getBestEffortElementReference(object: Object3D | null, worldPosition?: IfcMarkerWorldPosition): IfcMarkerElementReference {
    let current: Object3D | null = object
    let foundUserData: LooseIfcRecord | undefined

    while (current) {
      if (isLooseRecord(current.userData) && Object.keys(current.userData).length) {
        foundUserData = current.userData
        break
      }
      current = current.parent
    }

    return {
      modelFileName: file.name,
      modelUrl: file.url,
      modelId: file.id,
      expressId: readNumberRecordValue(foundUserData, ["expressID", "expressId", "ExpressID", "id", "elementId"]),
      globalId: readStringRecordValue(foundUserData, ["GlobalId", "globalId", "guid", "ifcGuid"]),
      entityType: readStringRecordValue(foundUserData, ["type", "ifcType", "entityType", "Name"]),
      elementName: readStringRecordValue(foundUserData, ["Name", "name", "LongName", "longName", "ObjectType"]),
      levelName: readStringRecordValue(foundUserData, ["level", "levelName", "storey", "buildingStorey"]),
      worldPosition,
      cameraSnapshot: getCameraSnapshot(),
    }
  }

  function getOverlayOnlyElementReference(xPercent: number, yPercent: number): IfcMarkerElementReference {
    return {
      modelFileName: file.name,
      modelUrl: file.url,
      modelId: file.id,
      propertySource: "ifc-overlay-screen",
      cameraSnapshot: getCameraSnapshot(),
      screenPosition: { xPercent, yPercent },
    }
  }

  // Reserved for later true IFC element snapping / Express ID lookup. MVP placement uses overlay coordinates only.
  async function pickIfcElement(clientX: number, clientY: number, xPercent: number, yPercent: number): Promise<IfcPickResult> {
    const container = viewerRef.current
    const camera = getWorldCamera()
    const model = runtimeRef.current?.model
    if (!container || !camera || !model) {
      return {
        elementReference: {
          modelFileName: file.name,
          modelUrl: file.url,
          modelId: file.id,
          cameraSnapshot: getCameraSnapshot(),
          screenPosition: { xPercent, yPercent },
        },
      }
    }

    const canvas = getDomCanvas(container)
    const raycastRect = canvas?.getBoundingClientRect() ?? container.getBoundingClientRect()
    const pointer = new Vector2(
      ((clientX - raycastRect.left) / raycastRect.width) * 2 - 1,
      -((clientY - raycastRect.top) / raycastRect.height) * 2 + 1,
    )

    const fragmentsManager = runtimeRef.current?.fragmentsManager
    const fragmentsRaycast = getRecordCallable(fragmentsManager, "raycast")
    if (fragmentsRaycast && canvas) {
      try {
        const fragmentsHit = normalizeFragmentsRaycastResult(await Promise.resolve(fragmentsRaycast.call(fragmentsManager, {
          camera,
          mouse: pointer,
          dom: canvas,
        })))
        if (fragmentsHit) {
          const worldPosition = asVectorPosition(fragmentsHit.point)
          return {
            elementReference: {
              ...getBestEffortElementReference(fragmentsHit.object ?? null, worldPosition),
              modelFileName: file.name,
              modelUrl: file.url,
              modelId: fragmentsHit.modelId ?? file.id,
              expressId: fragmentsHit.expressId,
              propertySource: fragmentsHit.source,
              worldPosition,
              cameraSnapshot: getCameraSnapshot(),
              screenPosition: { xPercent, yPercent },
            },
          }
        }
      } catch (raycastError) {
        console.warn("IFC fragments raycast failed", raycastError)
      }
    }

    const raycaster = new Raycaster()
    raycaster.setFromCamera(pointer, camera)
    const intersections = raycaster.intersectObject(model, true)
    const firstHit = intersections[0]
    const worldPosition = asVectorPosition(firstHit?.point)

    return {
      elementReference: {
        ...getBestEffortElementReference(firstHit?.object ?? null, worldPosition),
        screenPosition: { xPercent, yPercent },
      },
    }
  }

  // Reserved for later true IFC property loading.
  async function enrichIfcElementReference(base: IfcMarkerElementReference) {
    const propertyPatch = await readIfcPropertiesFromModel(runtimeRef.current?.rawModel ?? runtimeRef.current?.model, base.expressId)
    return mergeIfcElementReference(base, propertyPatch)
  }

  async function addMarkerFromClientPoint(clientX: number, clientY: number) {
    const container = markerLayerRef.current ?? viewerRef.current
    if (!container) return
    const rect = container.getBoundingClientRect()
    if (rect.width <= 0 || rect.height <= 0) return
    const xPercent = Math.min(99, Math.max(1, ((clientX - rect.left) / rect.width) * 100))
    const yPercent = Math.min(99, Math.max(1, ((clientY - rect.top) / rect.height) * 100))
    const elementReference = getOverlayOnlyElementReference(xPercent, yPercent)
    const hasModelHit = false
    const pickedElementLabel = undefined
    const isPhotoPlacement = markerPlacementMode === "photo" && Boolean(selectedPhotoForMarker)
    const nextMarker: PlanIssueMarker = isPhotoPlacement
      ? {
          id: `ifc-photo-marker-${Date.now()}`,
          sourceType: "ifc",
          ifcReference: elementReference,
          markerKind: "photo",
          ...buildMarkerIssuePatch(file, activeIssueId),
          photoId: selectedPhotoForMarker?.id,
          photoSerial: selectedPhotoForMarker?.serial,
          photoName: selectedPhotoForMarker?.name,
          photoNote: selectedPhotoForMarker?.note,
          photoPreviewUrl: selectedPhotoForMarker?.url || selectedPhotoForMarker?.dataUrl,
          serial: getNextIfcPhotoMarkerSerial(markers, activeIssueId),
          title: `IFC fotóhely jelölés · ${selectedPhotoForMarker?.serial || "F"}`,
          note: selectedPhotoForMarker?.note || "Fotó készítésének helye az IFC modellen.",
          issueSeverity: "Észrevétel",
          status: "Nyitott",
          issueStatus: "Nyitott",
          responsible: activeIssue?.responsible || "",
          dueDate: activeIssue?.deadline || formatDateInput(new Date()),
          discipline: "other",
          xPercent,
          yPercent,
          pageNumber: 1,
          showLetter: true,
          paperSize: "A4",
          orientation: "landscape",
          pdfFileName: file.name,
        }
      : {
          id: `ifc-marker-${Date.now()}`,
          sourceType: "ifc",
          ifcReference: elementReference,
          markerKind: "issue",
          ...buildMarkerIssuePatch(file, activeIssueId),
          serial: getNextIfcMarkerSerial(markers, activeIssueId),
          title: activeIssue?.title || file.issueTitle || "IFC modell hibahely",
          note: activeIssue?.description || activeIssue?.note || (pickedElementLabel ? `IFC elemhez kapcsolt hibahely: ${pickedElementLabel}` : "IFC modellnézeten képernyőpozícióként rögzített hibahely. A marker a modellnézeti pozíciót és a kameraállást menti."),
          issueSeverity: "Észrevétel",
          status: activeIssue?.status || "Nyitott",
          issueStatus: activeIssue?.status || "Nyitott",
          responsible: activeIssue?.responsible || "",
          dueDate: activeIssue?.deadline || formatDateInput(new Date()),
          discipline: activeDiscipline,
          xPercent,
          yPercent,
          pageNumber: 1,
          showLetter: true,
          paperSize: "A4",
          orientation: "landscape",
          pdfFileName: file.name,
        }
    const nextMarkers = [...markers, nextMarker]
    commitMarkers(nextMarkers)
    selectMarker(nextMarker.id)
    setPlacementMessage(hasModelHit
      ? `Marker rögzítve: ${nextMarker.serial} · ${Math.round(xPercent)}% / ${Math.round(yPercent)}%. IFC találat mentve metaadatként.`
      : `Marker rögzítve ott, ahová kattintottál: ${nextMarker.serial} · ${Math.round(xPercent)}% / ${Math.round(yPercent)}%.`)
    // IFC marker MVP: keep overlay markers at the clicked screen position.
  }

  async function selectIfcElementFromClientPoint(clientX: number, clientY: number) {
    const container = markerLayerRef.current ?? viewerRef.current
    if (!container) return
    const rect = container.getBoundingClientRect()
    if (rect.width <= 0 || rect.height <= 0) return
    const xPercent = Math.min(99, Math.max(1, ((clientX - rect.left) / rect.width) * 100))
    const yPercent = Math.min(99, Math.max(1, ((clientY - rect.top) / rect.height) * 100))
    try {
      const picked = await pickIfcElement(clientX, clientY, xPercent, yPercent)
      const enriched = await enrichIfcElementReference(picked.elementReference)
      setSelectedIfcElement({ reference: enriched, xPercent, yPercent, selectedAt: new Date().toISOString() })
      const label = enriched.elementName || enriched.entityType || (enriched.expressId ? `Express ID ${enriched.expressId}` : "IFC nézeti pont")
      setPlacementMessage(`IFC elem kijelölve: ${label}.`)
    } catch (error) {
      setPlacementMessage(`IFC elem kijelölés nem sikerült: ${formatIfcLoadError(error)}`)
    }
  }

  function addMeasurePointFromClientPoint(clientX: number, clientY: number) {
    const container = markerLayerRef.current ?? viewerRef.current
    if (!container) return
    const rect = container.getBoundingClientRect()
    if (rect.width <= 0 || rect.height <= 0) return
    const xPercent = Math.min(99, Math.max(1, ((clientX - rect.left) / rect.width) * 100))
    const yPercent = Math.min(99, Math.max(1, ((clientY - rect.top) / rect.height) * 100))
    const nextPoint: IfcMeasurePoint = {
      id: `ifc-measure-${Date.now()}`,
      xPercent,
      yPercent,
      clientX,
      clientY,
    }
    setMeasurePoints((current) => {
      const next = current.length >= 2 ? [nextPoint] : [...current, nextPoint]
      if (next.length === 1) setMeasureMessage("Első mérési pont rögzítve. Kattints a második pontra.")
      if (next.length === 2) {
        const distance = Math.hypot(next[1].clientX - next[0].clientX, next[1].clientY - next[0].clientY)
        setMeasureMessage(`Mérési előnézet: ${Math.round(distance)} px a jelenlegi képernyőnézeten. Valódi IFC méter mérés későbbi lépésben jön.`)
      }
      return next
    })
  }

  function handleIfcOverlayClick(event: React.MouseEvent<HTMLDivElement>) {
    if (isIfcMarkerUiTarget(event.target)) return
    if (viewMode === "mark") {
      handlePlacementClick(event)
      return
    }
    if (viewMode === "select") {
      event.preventDefault()
      event.stopPropagation()
      void selectIfcElementFromClientPoint(event.clientX, event.clientY)
      return
    }
    if (viewMode === "measure") {
      event.preventDefault()
      event.stopPropagation()
      addMeasurePointFromClientPoint(event.clientX, event.clientY)
    }
  }

  function requestMarkerPlacement(clientX: number, clientY: number) {
    const now = Date.now()
    const previous = lastPlacementRef.current
    const isDuplicate = previous
      && now - previous.time < 700
      && Math.abs(previous.clientX - clientX) < 18
      && Math.abs(previous.clientY - clientY) < 18
    if (isDuplicate) return
    lastPlacementRef.current = { time: now, clientX, clientY }
    void addMarkerFromClientPoint(clientX, clientY)
  }

  function handlePlacementPointerDown(event: React.PointerEvent<HTMLDivElement>) {
    if (viewMode !== "mark") return
    if (isIfcMarkerUiTarget(event.target)) return
    if (event.pointerType === "mouse" && event.button !== 0) return
    event.preventDefault()
    event.stopPropagation()
    placementPointerRef.current = {
      pointerId: event.pointerId,
      clientX: event.clientX,
      clientY: event.clientY,
      placedOnDown: true,
    }
    try {
      event.currentTarget.setPointerCapture(event.pointerId)
    } catch {}
    requestMarkerPlacement(event.clientX, event.clientY)
  }

  function handlePlacementPointerUp(event: React.PointerEvent<HTMLDivElement>) {
    if (viewMode !== "mark") return
    if (isIfcMarkerUiTarget(event.target)) return
    if (event.pointerType === "mouse" && event.button !== 0) return
    event.preventDefault()
    event.stopPropagation()
    const start = placementPointerRef.current
    placementPointerRef.current = null
    try {
      event.currentTarget.releasePointerCapture(event.pointerId)
    } catch {}
    if (start?.placedOnDown) return
    const movedDistance = start && start.pointerId === event.pointerId
      ? Math.hypot(event.clientX - start.clientX, event.clientY - start.clientY)
      : 0
    if (movedDistance > 45) {
      setPlacementMessage("Kameramozgatásnak érzékeltem, ezért nem rögzítettem új HJ-t.")
      return
    }
    requestMarkerPlacement(event.clientX, event.clientY)
  }

  function handlePlacementClick(event: React.MouseEvent<HTMLDivElement>) {
    if (viewMode !== "mark") return
    if (isIfcMarkerUiTarget(event.target)) return
    event.preventDefault()
    event.stopPropagation()
    requestMarkerPlacement(event.clientX, event.clientY)
  }

  function deleteSelectedMarker() {
    if (!selectedMarker) return
    const nextMarkers = markers.filter((marker) => marker.id !== selectedMarker.id)
    commitMarkers(nextMarkers)
    selectMarker(nextMarkers[0]?.id ?? null)
    setPlacementMessage(`Marker törölve: ${selectedMarker.serial}`)
  }

  function updateSelectedMarker(patch: Partial<PlanIssueMarker>) {
    if (!selectedMarker) return
    commitMarkers(markers.map((marker) => marker.id === selectedMarker.id ? { ...marker, ...patch } : marker))
  }

  function changeSelectedMarkerIssue(issueId: string) {
    if (!selectedMarker) return
    const issue = file.issues?.find((item) => item.id === issueId)
    updateSelectedMarker({
      ...buildMarkerIssuePatch(file, issueId),
      title: selectedMarker.title || issue?.title || file.issueTitle || "Új terepi hiba",
      issueLocation: selectedMarker.issueLocation || issue?.location || "",
      issueDescription: selectedMarker.issueDescription || issue?.description || "",
      issueSeverity: selectedMarker.issueSeverity || issue?.severity || "Észrevétel",
      responsible: selectedMarker.responsible || issue?.responsible || "",
      dueDate: selectedMarker.dueDate || issue?.deadline || formatDateInput(new Date()),
      status: selectedMarker.status || issue?.status || "Nyitott",
      issueStatus: selectedMarker.issueStatus || issue?.status || "Nyitott",
    })
  }

  function setDueDateOffset(days: number) {
    const base = selectedMarker?.dueDate ? new Date(`${selectedMarker.dueDate}T00:00:00`) : new Date()
    if (Number.isNaN(base.getTime())) return
    base.setDate(base.getDate() + days)
    updateSelectedMarker({ dueDate: formatDateInput(base) })
  }

  function setDueDateToday() {
    updateSelectedMarker({ dueDate: formatDateInput(new Date()) })
  }

  async function createIfcViewSnapshotDataUrl() {
    const viewer = viewerRef.current
    if (!viewer) throw new Error("IFC viewer nem található.")
    const sourceCanvas = getDomCanvas(viewer)
    if (!sourceCanvas) throw new Error("IFC canvas nem található.")

    const width = sourceCanvas.width || Math.round(sourceCanvas.getBoundingClientRect().width)
    const height = sourceCanvas.height || Math.round(sourceCanvas.getBoundingClientRect().height)
    if (!width || !height) throw new Error("IFC canvas mérete nem olvasható.")

    const exportCanvas = document.createElement("canvas")
    exportCanvas.width = width
    exportCanvas.height = height
    const context = exportCanvas.getContext("2d")
    if (!context) throw new Error("Export canvas nem hozható létre.")

    context.fillStyle = "#020617"
    context.fillRect(0, 0, width, height)
    try {
      context.drawImage(sourceCanvas, 0, 0, width, height)
    } catch (error) {
      console.warn("IFC canvas drawImage failed", error)
    }

    context.fillStyle = "rgba(2,6,23,0.34)"
    context.fillRect(0, 0, width, height)
    context.fillStyle = "rgba(34,211,238,0.10)"
    context.fillRect(0, 0, width, 34)
    context.fillStyle = "#e0f2fe"
    context.font = "900 14px Arial"
    context.fillText(`DIMPROVER IFC nézet · ${file.name}`, 18, 22)

    markers.forEach((marker) => {
      drawIfcExportMarker(
        context,
        marker,
        (marker.xPercent / 100) * width,
        (marker.yPercent / 100) * height,
        marker.id === selectedMarkerId,
      )
    })

    context.fillStyle = "rgba(15,23,42,0.72)"
    context.fillRect(0, height - 28, width, 28)
    context.fillStyle = "#a7f3d0"
    context.font = "900 11px Arial"
    context.fillText(`Markerek: ${markers.length} · Export: ${new Date().toLocaleString("hu-HU")}`, 18, height - 10)

    return exportCanvas.toDataURL("image/png")
  }

  async function exportIfcCurrentViewPng() {
    try {
      const dataUrl = await createIfcViewSnapshotDataUrl()
      const fileName = `${sanitizeIfcExportFileName(file.name.replace(/\.ifc$/i, ""))}_ifc_nezet_${new Date().toISOString().slice(0, 10)}.png`
      downloadIfcDataUrl(dataUrl, fileName)
      setExportMessage("IFC nézet PNG export elkészült.")
    } catch (error) {
      setExportMessage(formatIfcLoadError(error))
    }
  }

  async function saveSelectedMarkerIfcSnapshot() {
    if (!selectedMarker) return
    try {
      const dataUrl = await createIfcViewSnapshotDataUrl()
      const generatedAt = new Date().toISOString()
      commitMarkers(markers.map((marker) => marker.id === selectedMarker.id ? {
        ...marker,
        fullPlanSnapshotDataUrl: dataUrl,
        fullPlanSnapshotGeneratedAt: generatedAt,
        fullPlanSnapshotHexpinExportVersion: IFC_VIEW_EXPORT_VERSION,
        cropImageDataUrl: dataUrl,
        cropImageGeneratedAt: generatedAt,
        cropHexpinExportVersion: IFC_VIEW_EXPORT_VERSION,
      } : marker))
      setExportMessage(`Kijelölt marker IFC nézetképe mentve: ${selectedMarker.serial}`)
    } catch (error) {
      setExportMessage(formatIfcLoadError(error))
    }
  }

  async function saveAllIfcMarkerSnapshots() {
    if (!markers.length) return
    try {
      const dataUrl = await createIfcViewSnapshotDataUrl()
      const generatedAt = new Date().toISOString()
      commitMarkers(markers.map((marker) => ({
        ...marker,
        fullPlanSnapshotDataUrl: dataUrl,
        fullPlanSnapshotGeneratedAt: generatedAt,
        fullPlanSnapshotHexpinExportVersion: IFC_VIEW_EXPORT_VERSION,
        cropImageDataUrl: marker.cropImageDataUrl || dataUrl,
        cropImageGeneratedAt: marker.cropImageGeneratedAt || generatedAt,
        cropHexpinExportVersion: marker.cropHexpinExportVersion || IFC_VIEW_EXPORT_VERSION,
      })))
      setExportMessage(`IFC nézetkép mentve az összes markerhez: ${markers.length} db.`)
    } catch (error) {
      setExportMessage(formatIfcLoadError(error))
    }
  }

  function moveMarkerOnViewer(markerId: string, clientX: number, clientY: number) {
    const container = viewerRef.current
    if (!container) return
    const rect = container.getBoundingClientRect()
    if (rect.width <= 0 || rect.height <= 0) return
    const xPercent = Math.min(99, Math.max(1, ((clientX - rect.left) / rect.width) * 100))
    const yPercent = Math.min(99, Math.max(1, ((clientY - rect.top) / rect.height) * 100))
    commitMarkers(markers.map((marker) => marker.id === markerId ? { ...marker, xPercent, yPercent } : marker))
    setPlacementMessage(`Marker áthelyezve: ${Math.round(xPercent)}% / ${Math.round(yPercent)}%`)
  }

  function handleMarkerPointerDown(marker: PlanIssueMarker, event: React.PointerEvent<HTMLButtonElement>) {
    event.preventDefault()
    event.stopPropagation()
    selectMarker(marker.id)
    markerDragRef.current = {
      markerId: marker.id,
      pointerId: event.pointerId,
      startClientX: event.clientX,
      startClientY: event.clientY,
      startXPercent: marker.xPercent,
      startYPercent: marker.yPercent,
      moved: false,
    }
    try {
      event.currentTarget.setPointerCapture(event.pointerId)
    } catch {}
  }

  function handleMarkerPointerMove(event: React.PointerEvent<HTMLButtonElement>) {
    const drag = markerDragRef.current
    if (!drag || drag.pointerId !== event.pointerId) return
    event.preventDefault()
    event.stopPropagation()
    const container = viewerRef.current
    if (!container) return
    const rect = container.getBoundingClientRect()
    if (rect.width <= 0 || rect.height <= 0) return
    const dx = event.clientX - drag.startClientX
    const dy = event.clientY - drag.startClientY
    if (Math.hypot(dx, dy) > 3) drag.moved = true
    const xPercent = Math.min(99, Math.max(1, drag.startXPercent + (dx / rect.width) * 100))
    const yPercent = Math.min(99, Math.max(1, drag.startYPercent + (dy / rect.height) * 100))
    commitMarkers(markers.map((marker) => marker.id === drag.markerId ? { ...marker, xPercent, yPercent } : marker))
  }

  function handleMarkerPointerUp(event: React.PointerEvent<HTMLButtonElement>) {
    const drag = markerDragRef.current
    if (!drag || drag.pointerId !== event.pointerId) return
    event.preventDefault()
    event.stopPropagation()
    markerDragRef.current = null
    try {
      event.currentTarget.releasePointerCapture(event.pointerId)
    } catch {}
    if (drag.moved) moveMarkerOnViewer(drag.markerId, event.clientX, event.clientY)
  }

  function handleMarkerPointerCancel(event: React.PointerEvent<HTMLButtonElement>) {
    const drag = markerDragRef.current
    if (!drag || drag.pointerId !== event.pointerId) return
    event.preventDefault()
    event.stopPropagation()
    markerDragRef.current = null
  }

