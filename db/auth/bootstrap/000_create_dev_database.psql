\set ON_ERROR_STOP on

-- DEV ONLY · PROD DENY
-- Usage example (run as PostgreSQL administrator):
-- Export secrets before execution so they do not appear in command arguments:
--   export DIMPRO_AUTH_MIGRATION_PASSWORD='...'
--   export DIMPRO_AUTH_APP_PASSWORD='...'
--   psql "$ADMIN_DATABASE_URL" --file=db/auth/bootstrap/000_create_dev_database.psql

\getenv auth_migration_password DIMPRO_AUTH_MIGRATION_PASSWORD
\getenv auth_app_password DIMPRO_AUTH_APP_PASSWORD
\if :{?auth_migration_password}
\else
  \echo 'ERROR: DIMPRO_AUTH_MIGRATION_PASSWORD is required'
  \quit 3
\endif
\if :{?auth_app_password}
\else
  \echo 'ERROR: DIMPRO_AUTH_APP_PASSWORD is required'
  \quit 3
\endif

\set db_name 'dimpro_auth_dev'
\set migration_role 'dimpro_auth_migrator_dev'
\set app_role 'dimpro_auth_app_dev'

SELECT format('CREATE ROLE %I LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION', :'migration_role', :'auth_migration_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname=:'migration_role')
\gexec

SELECT format('ALTER ROLE %I PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION', :'migration_role', :'auth_migration_password')
\gexec

SELECT format('CREATE ROLE %I LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION', :'app_role', :'auth_app_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname=:'app_role')
\gexec

SELECT format('ALTER ROLE %I PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION', :'app_role', :'auth_app_password')
\gexec

SELECT format('CREATE DATABASE %I OWNER %I TEMPLATE template0 ENCODING %L', :'db_name', :'migration_role', 'UTF8')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname=:'db_name')
\gexec

SELECT format('REVOKE ALL ON DATABASE %I FROM PUBLIC', :'db_name') \gexec
SELECT format('GRANT CONNECT ON DATABASE %I TO %I', :'db_name', :'migration_role') \gexec
SELECT format('GRANT CONNECT ON DATABASE %I TO %I', :'db_name', :'app_role') \gexec

\connect :db_name

CREATE EXTENSION IF NOT EXISTS pgcrypto;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
SELECT format('ALTER SCHEMA public OWNER TO %I', :'migration_role') \gexec
SELECT format('GRANT USAGE ON SCHEMA public TO %I', :'app_role') \gexec

-- Runtime table privileges are intentionally NOT granted here.
-- Migration 004_auth_v022_runtime_privileges.sql grants only the exact runtime
-- DML required by the application. No broad default privileges are used.

SELECT current_database() AS database_name, current_user AS bootstrap_user;
\echo 'DIMPRO AUTH DEV database bootstrap complete.'
