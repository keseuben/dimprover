  const totalVirtualHeight = useMemo(() => visibleRowLayouts.at(-1)?.bottom ?? 0, [visibleRowLayouts]);
  useEffect(() => {
    const updateScheduleViewportHeight = () => {
      const element = scheduleScrollRef.current;
      const rect = element?.getBoundingClientRect();
      const top = Math.max(0, rect?.top ?? 360);
      const bottomReserve = 24;
      const availableHeight = Math.floor(window.innerHeight - top - bottomReserve);
      const tallTarget = Math.floor(window.innerHeight * 0.58);
      const nextHeight = Math.max(520, Math.min(Math.max(availableHeight, tallTarget), Math.floor(window.innerHeight * 0.78)));

      setScheduleViewportHeight(nextHeight);
      if (element) {
        setViewportWidth(element.clientWidth);
        setViewportHeight(nextHeight);
      } else {
        setViewportHeight(nextHeight);
      }
    };

    updateScheduleViewportHeight();
    const timeoutId = window.setTimeout(updateScheduleViewportHeight, 0);
    const timeoutId2 = window.setTimeout(updateScheduleViewportHeight, 250);
    window.addEventListener("resize", updateScheduleViewportHeight);
    window.addEventListener("scroll", updateScheduleViewportHeight, true);

    return () => {
      window.clearTimeout(timeoutId);
      window.clearTimeout(timeoutId2);
      window.removeEventListener("resize", updateScheduleViewportHeight);
      window.removeEventListener("scroll", updateScheduleViewportHeight, true);
    };
  }, [features.showLegend, viewMode, zoomLevel, scheduleRevision, isPdfPreviewOpen]);

