{
  "name": "@dimpro/benjadmin-developer-grid-desktop",
  "version": "0.1.11",
  "private": true,
  "description": "BENJADMIN Developer Grid – AI Engineering Control Center / AI Fejlesztésirányítási Központ",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/acceptance.mjs && node scripts/shortcut-contract.mjs && node scripts/system-health-contract.mjs && node scripts/v019-workspace-chat-contract.mjs",
    "dist:win": "electron-builder --win portable --x64",
    "package:dev": "bash scripts/package-dev-release.sh"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "hu.dimpro.benjadmin.developergrid",
    "productName": "BENJADMIN Developer Grid",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "README.md",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "BENJADMIN-Developer-Grid-${version}-Windows-x64.${ext}",
      "icon": "src/assets/app-icon.ico",
      "signExecutable": false
    },
    "artifactName": "BENJADMIN-Developer-Grid-${version}-Windows-x64.${ext}"
  }
}
